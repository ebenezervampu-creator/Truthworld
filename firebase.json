            }
          ]
        },
        {
          "source": "/embed/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "X-Frame-Options",
              "value": "ALLOWALL"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self' 'unsafe-inline' https: data: blob:; frame-ancestors *;"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Clear-Site-Data",
              "value": "\"cache\""
            }
          ]
        },
        {
          "source": "index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Clear-Site-Data",
              "value": "\"cache\""
            }
          ]
        },
        {
