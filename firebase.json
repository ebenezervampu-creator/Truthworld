{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "web-app",
      "public": "build/web_app",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],

      "rewrites": [
        {
          "source": "/api/feed/**",
          "function": {
            "functionId": "publicFeedServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/checkout",
          "function": {
            "functionId": "cashfreeHostedCheckout",
            "region": "asia-south1"
          }
        },
        {
          "source": "/checkout/**",
