            "region": "asia-south1"
          }
        },
        {
          "source": "/advertiser/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/advertisements",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/advertisements/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/ads",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/ads/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/[Pp]ost/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/[Cc]ommunity/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
