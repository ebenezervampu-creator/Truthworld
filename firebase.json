          "source": "/embed",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/embed/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/v/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/shorts/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/[Ww]atch",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/[Ww]atch/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/[Cc]hannel/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/@**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/[Tt]opic/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/T/**",
