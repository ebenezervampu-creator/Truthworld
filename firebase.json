{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "web-app",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],

      "rewrites": [
        {
          "source": "/sitemap*.xml",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/studio",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/studio/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/.well-known/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/advertiser",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/advertiser/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/advertisements",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/advertisements/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/ads",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/post/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/community/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/watch",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/watch/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/channel/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/@**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/topic/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/T/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/playlist",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/playlist/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/feeds/**",
          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/robots.txt",
          "destination": "/robots.txt"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "flutter_bootstrap.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/canvaskit/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            },
            {
              "key": "Cross-Origin-Resource-Policy",
              "value": "cross-origin"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=()"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://apis.google.com https://www.gstatic.com https://accounts.google.com https://www.google.com https://recaptcha.net https://www.recaptcha.net; worker-src 'self' blob: https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' data: https://fonts.gstatic.com https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https://firebasestorage.googleapis.com https://*.googleapis.com https:; connect-src 'self' blob: https://*.firebaseio.com wss://*.firebaseio.com https://*.googleapis.com https://www.gstatic.com https://fonts.gstatic.com https://*.firebaseapp.com https://www.google.com https://*.google.com; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com https://www.google.com https://recaptcha.net https://www.recaptcha.net; object-src 'none'; base-uri 'self';"
            }
          ]
        }
      ]
    },
