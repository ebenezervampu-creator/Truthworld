          "function": {
            "functionId": "seoServer",
            "region": "asia-south1"
          }
        },
        {
          "source": "/robots.txt",
          "destination": "/robots.txt"
        },
        {
          "source": "/llms.txt",
          "destination": "/llms.txt"
        },
        {
          "source": "/llms-full.txt",
          "destination": "/llms-full.txt"
        },
        {
          "source": "**/*.map",
          "destination": "/flutter.js.map"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(css|woff|woff2|ttf|otf|eot|ico|png|jpg|jpeg|gif|webp|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(js|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
