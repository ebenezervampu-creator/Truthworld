{
  "lifecycle": {
    "rule": [
      {
        "action": {
          "type": "Delete"
        },
        "condition": {
          "age": 30,
          "matchesPrefix": [
            "videos/"
          ],
          "matchesSuffix": [
            "/original.mp4"
          ]
        }
      }
    ]
  }
}
