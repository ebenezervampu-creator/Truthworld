  Widget _buildStepNavigation({
    required bool isDark,
    bool showBack = false,
    String? nextLabel,
    Widget? customAction,
  }) {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 24),
      child: Row(
        children: [
          if (showBack) ...[
            Expanded(
              child: Container(
                height: 56,
                decoration: BoxDecoration(
                  borderRadius: BorderRadius.circular(16),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withValues(alpha: 0.05),
                      blurRadius: 12,
                      offset: const Offset(0, 4),
                    ),
                  ],
                ),
                child: OutlinedButton.icon(
                  onPressed: _goToPreviousStep,
                  icon: const Icon(Icons.arrow_back_rounded, size: 20),
                  label: Text(
                    'Back',
                    style: GoogleFonts.inter(
                      fontSize: 15,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  style: OutlinedButton.styleFrom(
                    foregroundColor:
                        isDark ? Colors.white : const Color(0xFF374151),
                    side: BorderSide(
                      color: isDark
                          ? const Color(0xFF4B5563)
                          : const Color(0xFFD1D5DB),
                      width: 2,
                    ),
                    backgroundColor:
                        isDark ? const Color(0xFF1F2937) : Colors.white,
                    padding: const EdgeInsets.symmetric(vertical: 16),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(16),
                    ),
                  ),
                ),
              ),
            ),
            const SizedBox(width: 16),
          ],
          Expanded(
            flex: showBack ? 2 : 1,
            child: customAction ??
                Container(
                  height: 56,
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(16),
                    gradient: const LinearGradient(
                      colors: [Color(0xFF3B82F6), Color(0xFF2563EB)],
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: const Color(0xFF3B82F6).withValues(alpha: 0.4),
                        blurRadius: 16,
                        offset: const Offset(0, 6),
                        spreadRadius: 0,
                      ),
                    ],
                  ),
                  child: ElevatedButton.icon(
                    onPressed: _handleNextStep,
                    icon: const Icon(Icons.arrow_forward_rounded, size: 20),
                    label: Text(
                      nextLabel ?? 'Continue',
                      style: GoogleFonts.inter(
                        fontSize: 15,
                        fontWeight: FontWeight.w700,
                        letterSpacing: 0.3,
                      ),
                    ),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: Colors.transparent,
                      foregroundColor: Colors.white,
                      shadowColor: Colors.transparent,
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(16),
                      ),
                      padding: const EdgeInsets.symmetric(vertical: 16),
                    ),
                  ),
                ),
          ),
        ],
      ),
    );
  }

  void _handleNextStep() {
    print("--- Navigating to next step from step $_currentStep ---");
    bool canProceed = true;
    String errorMessage = '';

    switch (_currentStep) {
      case 0:
        print("Validating Step 1: Media Selection");
        if (_uploadController.pickedVideo.value == null) {
          errorMessage += 'Please select a video.\n';
          canProceed = false;
        }
        if (_uploadController.pickedImage.value == null) {
          errorMessage += 'Please select a thumbnail.';
          canProceed = false;
        }
        print(
          "Step 1 validation result: canProceed=$canProceed, errorMessage='$errorMessage'",
        );
        break;
      case 1:
        print("Validating Step 2: Basic Info");
        if (_videoDetailsFormKey.currentState != null &&
            !_videoDetailsFormKey.currentState!.validate()) {
          canProceed = false;
          errorMessage = 'Please fill in all required fields correctly.';
        } else if (_uploadController.selectedCategory.value.isEmpty) {
          canProceed = false;
          errorMessage = 'Please select a category.';
        }
        print(
          "Step 2 validation result: canProceed=$canProceed, errorMessage='$errorMessage'",
        );
        break;
      case 2:
        print("Validating Step 3: Advanced Settings");
        // Additional validation if needed for step 3
        print("Step 3 validation result: canProceed=true, errorMessage=''");
        break;
      case 3:
        print("Step 4: No validation needed for final step");
        break;
      // For other steps, assume can proceed
    }

    if (canProceed) {
      print("Proceeding to next step.");
      _goToNextStep();
    } else {
      print("Cannot proceed. Showing error snackbar.");
      Get.snackbar(
        'Cannot Proceed',
        errorMessage.trim(),
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
        duration: const Duration(seconds: 3),
      );
      HapticFeedback.heavyImpact();
    }
  }

