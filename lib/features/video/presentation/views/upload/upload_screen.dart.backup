  // ========== VIDEO/MEDIA PICKER METHODS ==========

  Future<void> _pickVideo() async {
    await _uploadController.pickVideo();
    
    // Auto-fill title from filename if empty
    if (_titleController.text.trim().isEmpty && _uploadController.pickedVideo.value != null) {
      final fileName = _uploadController.pickedVideo.value!.name;
      final nameWithoutExtension = fileName.contains('.') 
          ? fileName.substring(0, fileName.lastIndexOf('.'))
          : fileName;
      _titleController.text = nameWithoutExtension;
    }
  }

  Widget _buildThumbnailUpload(bool isDark) {
    return Obx(() {
      final hasImage = _uploadController.pickedImage.value != null;
      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Thumbnail',
            style: GoogleFonts.inter(
              fontSize: 14,
              fontWeight: FontWeight.w600,
              color: isDark ? Colors.white : const Color(0xFF0F172A),
            ),
          ),
          const SizedBox(height: 10),
          InkWell(
            onTap: () => _uploadController.pickImage(forCommunity: false),
            borderRadius: BorderRadius.circular(12),
            child: Container(
              height: 120,
              decoration: BoxDecoration(
                color:
                    isDark ? const Color(0xFF0D1117) : const Color(0xFFF9FAFB),
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: isDark
                      ? const Color(0xFF30363D)
                      : const Color(0xFFE5E7EB),
                  width: 2,
                ),
              ),
              child: hasImage
                  ? ClipRRect(
                      borderRadius: BorderRadius.circular(10),
                      child: Image(
                        image: kIsWeb
                            ? MemoryImage(
                                _uploadController.pickedImage.value!.bytes!)
                            : FileImage(io.File(
                                    _uploadController.pickedImage.value!.path!))
                                as ImageProvider,
                        fit: BoxFit.cover,
                        width: double.infinity,
                      ),
                    )
                  : Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Icon(
                          Icons.add_photo_alternate_rounded,
                          size: 32,
                          color:
                              isDark ? Colors.white38 : const Color(0xFF9CA3AF),
                        ),
                        const SizedBox(height: 8),
                        Text(
                          'Add thumbnail',
                          style: GoogleFonts.inter(
                            fontSize: 13,
                            color: isDark
                                ? Colors.white38
                                : const Color(0xFF9CA3AF),
                          ),
                        ),
                      ],
                    ),
            ),
          ),
        ],
      );
    });
  }

  Widget _buildInputField({
    required bool isDark,
    required TextEditingController controller,
    required String hint,
    int maxLines = 1,
    int? maxLength,
    String? Function(String?)? validator,
  }) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Container(
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(14),
          ),
          child: TextFormField(
            controller: controller,
            maxLines: maxLines,
            maxLength: maxLength,
            validator: validator,
            style: GoogleFonts.inter(
              fontSize: 14,
              fontWeight: FontWeight.w500,
              color: isDark ? Colors.white : const Color(0xFF0F172A),
              height: 1.5,
            ),
            decoration: InputDecoration(
              hintText: hint,
              hintStyle: GoogleFonts.inter(
                color: isDark
                    ? Colors.white.withValues(alpha: 0.3)
                    : const Color(0xFF9CA3AF),
                fontSize: 14,
              ),
              filled: true,
              fillColor:
                  isDark ? const Color(0xFF161B22) : const Color(0xFFF9FAFB),
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide: BorderSide(
                  color: isDark
                      ? const Color(0xFF30363D)
                      : const Color(0xFFE5E7EB),
                  width: 1.5,
                ),
              ),
              enabledBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide: BorderSide(
                  color: isDark
                      ? const Color(0xFF30363D)
                      : const Color(0xFFE5E7EB),
                  width: 1.5,
                ),
              ),
              focusedBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide:
                    const BorderSide(color: Color(0xFF6366F1), width: 2),
              ),
              errorBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide:
                    const BorderSide(color: Color(0xFFEF4444), width: 1.5),
              ),
              focusedErrorBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide:
                    const BorderSide(color: Color(0xFFEF4444), width: 2),
              ),
              contentPadding: EdgeInsets.symmetric(
                horizontal: 18,
                vertical: maxLines > 1 ? 16 : 14,
              ),
            ),
          ),
        ),
      ],
    );
  }

  void _handleVideoUpload() async {
    print("--- Step 4: Publish Review ---");
    print("Initiating video upload process...");

    // 1️⃣ Validation: Required fields
    final canPublish = _canPublishVideo();
    if (!canPublish) {
      String errorMessage = 'Cannot publish. Validation checks:\n';
      if (_uploadController.videoUrl.value.isEmpty)
        errorMessage += '- Video not uploaded yet.\n';
      if (_uploadController.thumbnailUrl.value.isEmpty)
        errorMessage += '- Thumbnail not uploaded yet.\n';
      if (_titleController.text.trim().isEmpty)
        errorMessage += '- Title is required.\n';
      if (_titleController.text.length < 5)
        errorMessage += '- Title must be at least 5 characters long.\n';
      if (_descriptionController.text.trim().isEmpty)
        errorMessage += '- Description is required.\n';
      if (_descriptionController.text.length < 10)
        errorMessage += '- Description must be at least 10 characters long.\n';
      if (_uploadController.selectedCategory.value.isEmpty)
        errorMessage += '- Category is required.\n';
      if (_uploadController.selectedChannel.value == null)
        errorMessage += '- Channel not selected.\n';
      if (_uploadController.isUploading.value)
        errorMessage += '- An upload is already in progress.\n';

      Get.snackbar(
        'Cannot Publish',
        errorMessage.trim(),
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
        duration: const Duration(seconds: 5),
      );
      return;
    }

    // 2️⃣ Thumbnail moderation check
    /* Moderation check bypassed for smoother creation
    final status = _uploadController.finalstatus.value;
    if (status == 'REJECTED') {
      Get.snackbar(
        "Thumbnail Rejected",
        "You cannot publish because the thumbnail was rejected.",
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
      );
      return;
    }
    if (status != 'APPROVED') {
      Get.snackbar(
        "Thumbnail Not Approved",
        "Your thumbnail must be approved before publishing.",
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
        duration: const Duration(seconds: 4),
      );
      return;
    }
    */

    // 3️⃣ Manual form validation
    if (_titleController.text.trim().length < 5) {
      Get.snackbar("Form Error", "Title must be at least 5 characters long",
          backgroundColor: const Color(0xFFEF4444), colorText: Colors.white);
      return;
    }
    if (_descriptionController.text.trim().length < 10) {
      Get.snackbar(
          "Form Error", "Description must be at least 10 characters long",
          backgroundColor: const Color(0xFFEF4444), colorText: Colors.white);
      return;
    }

    // 4️⃣ Ensure channel is selected
    if (_uploadController.selectedChannel.value == null) {
      Get.snackbar("Channel Required", "Please select a channel to publish to",
          backgroundColor: const Color(0xFFEF4444), colorText: Colors.white);
      return;
    }

    try {
      setState(() {
        _isProcessing = true;
        _processingMessage = 'Publishing video...';
      });

      final channel = _uploadController.selectedChannel.value!;
      final tags = _tagsController.text
          .split(',')
          .map((tag) => tag.trim())
          .where((tag) => tag.isNotEmpty)
          .toList();
      final selectedLanguages =
          _languageSelectionController.selectedLanguages.toList();

      // Upload video
      await _uploadController.uploadVideo(
        _titleController.text.trim(),
        _descriptionController.text.trim(),
        channel.channelName,
        channel.channelId,
        channel.avatarUrl,
        tags,
        selectedLanguages,
      );

      HapticFeedback.mediumImpact();
      Get.snackbar(
        "Upload Started",
        "Your video is being processed and will be available soon",
        backgroundColor: const Color(0xFF10B981),
        colorText: Colors.white,
        duration: const Duration(seconds: 3),
      );
    } catch (e) {
      String errorMessage = 'Failed to upload video. Please try again.';
      if (e is FirebaseException) {
        errorMessage = 'Firebase error: ${e.message}';
      } else if (e is io.IOException) {
        errorMessage = 'Network error: Check your internet connection.';
      } else if (e is FormatException) {
        errorMessage = 'Invalid data format. Please check your input.';
      }
      Get.snackbar("Upload Error", errorMessage,
          backgroundColor: const Color(0xFFEF4444), colorText: Colors.white);
      debugPrint('Video upload error: $e');
    } finally {
      setState(() {
        _isProcessing = false;
        _processingMessage = '';
      });
    }
  }

  void _handleCommunityUpload() async {
    if (!_canPublishCommunity()) {
      String errorMessage = '';
      if (_uploadController.thumbnailUrl.value.isEmpty)
        errorMessage += 'Image not added.\n';
      if (_communityTitleController.text.trim().isEmpty)
        errorMessage += 'Title is required.\n';
      if (_communityDescriptionController.text.trim().isEmpty)
        errorMessage += 'Description is required.\n';
      if (_uploadController.selectedChannel.value == null)
        errorMessage += 'Please select a channel.';
      Get.snackbar(
        'Cannot Publish',
        errorMessage.trim(),
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
        duration: const Duration(seconds: 3),
      );
      return;
    }

    if (!_communityDetailsFormKey.currentState!.validate()) {
      Get.snackbar(
        "Form Error",
        "Please fill in all required fields correctly",
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
      );
      return;
    }

    if (_uploadController.selectedChannel.value == null) {
      Get.snackbar(
        "Channel Required",
        "Please select a channel to publish to",
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
      );
      return;
    }

    try {
      setState(() {
        _isProcessing = true;
        _processingMessage = 'Publishing community post...';
      });

      final tags = _communityTagsController.text
          .split(',')
          .map((tag) => tag.trim())
          .where((tag) => tag.isNotEmpty)
          .toList();

      await _uploadController.uploadCommunityPost(
        _communityTitleController.text.trim(),
        _communityDescriptionController.text.trim(),
        _uploadController.selectedChannel.value!.channelName,
        _uploadController.selectedChannel.value!.channelId,
        _uploadController.selectedChannel.value!.avatarUrl,
        tags,
      );

      HapticFeedback.mediumImpact();

      // Show success feedback
      Get.snackbar(
        "Post Published",
        "Your community post has been published successfully",
        backgroundColor: const Color(0xFF10B981),
        colorText: Colors.white,
        duration: const Duration(seconds: 3),
      );
    } catch (e) {
      // Enhanced error handling
      String errorMessage =
          'Failed to publish community post. Please try again.';
      if (e is FirebaseException) {
        errorMessage = 'Firebase error: ${e.message}';
      } else if (e is io.IOException) {
        errorMessage = 'Network error: Check your internet connection.';
      } else if (e is FormatException) {
        errorMessage = 'Invalid data format. Please check your input.';
      }
      Get.snackbar(
        "Publish Error",
        errorMessage,
        backgroundColor: const Color(0xFFEF4444),
        colorText: Colors.white,
      );
      debugPrint('Community post upload error: $e');
    } finally {
      setState(() {
        _isProcessing = false;
        _processingMessage = '';
      });
    }
  }

  // Utility Methods
  IconData _getVisibilityIcon(String visibility) {
    switch (visibility.toLowerCase()) {
      case 'public':
        return Icons.public_rounded;
      case 'unlisted':
        return Icons.link_rounded;
      case 'private':
        return Icons.lock_rounded;
      default:
        return Icons.help_outline_rounded;
    }
  }

  String _getVisibilityDescription(String visibility) {
    switch (visibility.toLowerCase()) {
      case 'public':
        return 'Anyone can search for and view';
      case 'unlisted':
        return 'Anyone with the link can view';
      case 'private':
        return 'Only you can view';
      default:
        return 'Select visibility option';
    }
  }

  @override
  void debugFillProperties(DiagnosticPropertiesBuilder properties) {
    super.debugFillProperties(properties);
    properties.add(IntProperty('currentStep', _currentStep));
    properties.add(IntProperty('totalSteps', _totalSteps));
    properties.add(FlagProperty('isProcessing', value: _isProcessing));
    properties.add(StringProperty('processingMessage', _processingMessage));
    properties.add(DoubleProperty('overallProgress', _overallProgress));
  }

