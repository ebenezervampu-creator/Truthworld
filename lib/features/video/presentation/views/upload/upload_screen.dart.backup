  Widget _buildVideoPublishPreview(bool isDark) {
    return Obx(() {
      final hasVideo = _uploadController.pickedVideo.value != null;
      final hasThumbnail = _uploadController.pickedImage.value != null;
      final videoController = _uploadController.videoPlayerController;

      return Container(
        padding: const EdgeInsets.all(24),
        decoration: BoxDecoration(
          color: isDark ? const Color(0xFF161B22) : Colors.white,
          borderRadius: BorderRadius.circular(16),
          border: Border.all(
            color: isDark ? const Color(0xFF30363D) : const Color(0xFFE5E7EB),
          ),
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Icon(
                  Icons.visibility_rounded,
                  size: 20,
                  color: const Color(0xFF6366F1),
                ),
                const SizedBox(width: 10),
                Text(
                  'Preview',
                  style: GoogleFonts.inter(
                    fontSize: 14,
                    fontWeight: FontWeight.w600,
                    color: isDark ? Colors.white : const Color(0xFF0F172A),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 20),
            // Video Preview with Player
            if (hasVideo &&
                videoController != null &&
                videoController.value.isInitialized)
              Container(
                height: 150,
                margin: const EdgeInsets.only(bottom: 16),
                decoration: BoxDecoration(
                  borderRadius: BorderRadius.circular(12),
                  color: Colors.black,
                ),
                child: ClipRRect(
                  borderRadius: BorderRadius.circular(12),
                  child: InkWell(
                    onTap: () {
                      if (videoController.value.isPlaying) {
                        videoController.pause();
                      } else {
                        videoController.play();
                      }
                      HapticFeedback.lightImpact();
                    },
                    child: Stack(
                      alignment: Alignment.center,
                      children: [
                        SizedBox.expand(
                          child: FittedBox(
                            fit: BoxFit.cover,
                            child: SizedBox(
                              width: videoController.value.size.width,
                              height: videoController.value.size.height,
                              child: VideoPlayer(videoController),
                            ),
                          ),
                        ),
                        if (!videoController.value.isPlaying)
                          Container(
                            padding: const EdgeInsets.all(12),
                            decoration: BoxDecoration(
                              color: Colors.black.withValues(alpha: 0.6),
                              shape: BoxShape.circle,
                            ),
                            child: const Icon(
                              Icons.play_arrow_rounded,
                              size: 32,
                              color: Colors.white,
                            ),
                          ),
                      ],
                    ),
                  ),
                ),
              ),
            // Thumbnail Preview
            if (hasThumbnail)
              Container(
                height: 100,
                margin: const EdgeInsets.only(bottom: 16),
                decoration: BoxDecoration(
                  borderRadius: BorderRadius.circular(12),
                  image: DecorationImage(
                    image: kIsWeb
                        ? MemoryImage(
                            _uploadController.pickedImage.value!.bytes!)
                        : FileImage(io.File(
                                _uploadController.pickedImage.value!.path!))
                            as ImageProvider,
                    fit: BoxFit.cover,
                  ),
                ),
              ),
            _buildPreviewItem(
              isDark,
              Icons.videocam_rounded,
              'Video',
              hasVideo ? 'Selected' : 'Not selected',
              hasVideo,
            ),
            const SizedBox(height: 12),
            _buildPreviewItem(
              isDark,
              Icons.image_rounded,
              'Thumbnail',
              hasThumbnail ? 'Selected' : 'Not selected',
              hasThumbnail,
            ),
            const SizedBox(height: 12),
            _buildPreviewItem(
              isDark,
              Icons.title_rounded,
              'Title',
              _titleController.text.isNotEmpty
                  ? _titleController.text
                  : 'Not added',
              _titleController.text.isNotEmpty,
            ),
            const SizedBox(height: 12),
            _buildPreviewItem(
              isDark,
              Icons.category_rounded,
              'Category',
              _uploadController.selectedCategory.value.isNotEmpty
                  ? _uploadController.selectedCategory.value
                  : 'Not selected',
              _uploadController.selectedCategory.value.isNotEmpty,
            ),
            const SizedBox(height: 12),
            _buildPreviewItem(
              isDark,
              Icons.public_rounded,
              'Visibility',
              _uploadController.selectedVisibility.value,
              true,
            ),
          ],
        ),
      );
    });
  }

  Widget _buildPreviewItem(
      bool isDark, IconData icon, String label, String value, bool isComplete) {
    return Row(
      children: [
        Icon(
          icon,
          size: 16,
          color: isComplete
              ? const Color(0xFF10B981)
              : isDark
                  ? Colors.white38
                  : const Color(0xFF9CA3AF),
        ),
        const SizedBox(width: 10),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: GoogleFonts.inter(
                  fontSize: 11,
                  color: isDark ? Colors.white60 : const Color(0xFF64748B),
                ),
              ),
              Text(
                value,
                style: GoogleFonts.inter(
                  fontSize: 12,
                  fontWeight: FontWeight.w500,
                  color: isComplete
                      ? (isDark ? Colors.white : const Color(0xFF0F172A))
                      : (isDark ? Colors.white38 : const Color(0xFF9CA3AF)),
                ),
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
              ),
            ],
          ),
        ),
      ],
    );
  }

  // ========== SEPARATE COMMUNITY POST COMPONENTS ==========

  Widget _buildCommunityImageSection(bool isDark) {
    return Obx(() {
      final hasImage = _uploadController.pickedImage.value != null;
      return Container(
        padding: const EdgeInsets.all(24),
        decoration: BoxDecoration(
          color: isDark ? const Color(0xFF161B22) : Colors.white,
          borderRadius: BorderRadius.circular(16),
          border: Border.all(
            color: isDark ? const Color(0xFF30363D) : const Color(0xFFE5E7EB),
          ),
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Icon(
                  Icons.image_rounded,
                  size: 20,
                  color: const Color(0xFFF59E0B),
                ),
                const SizedBox(width: 10),
                Text(
                  'Community Image',
                  style: GoogleFonts.inter(
                    fontSize: 14,
                    fontWeight: FontWeight.w600,
                    color: isDark ? Colors.white : const Color(0xFF0F172A),
                  ),
                ),
                const Spacer(),
                if (_uploadController.finalstatus.value.isNotEmpty)
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(
                      color: _uploadController.finalstatus.value == "REJECTED" ? Colors.red.withValues(alpha: 0.1) : 
                             _uploadController.finalstatus.value == "FLAGGED" ? Colors.orange.withValues(alpha: 0.1) : 
                             _uploadController.finalstatus.value == "APPROVED" ? Colors.green.withValues(alpha: 0.1) : 
                             Colors.blue.withValues(alpha: 0.1),
                      borderRadius: BorderRadius.circular(20),
                    ),
                    child: Text(
                      _uploadController.finalstatus.value,
                      style: GoogleFonts.inter(
                        fontSize: 11,
                        fontWeight: FontWeight.bold,
                        color: _uploadController.finalstatus.value == "REJECTED" ? Colors.red : 
                               _uploadController.finalstatus.value == "FLAGGED" ? Colors.orange : 
                               _uploadController.finalstatus.value == "APPROVED" ? Colors.green : 
                               Colors.blue,
                      ),
                    ),
                  ),
              ],
            ),
            const SizedBox(height: 16),
            InkWell(
              onTap: () => _uploadController.pickImage(forCommunity: true),
              borderRadius: BorderRadius.circular(12),
              child: Container(
                height: 200,
                decoration: BoxDecoration(
                  color: hasImage
                      ? const Color(0xFFF59E0B).withValues(alpha: 0.1)
                      : isDark
                          ? const Color(0xFF0D1117)
                          : const Color(0xFFF9FAFB),
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(
                    color: _uploadController.finalstatus.value == "REJECTED" ? Colors.red.withValues(alpha: 0.5) :
                           _uploadController.finalstatus.value == "FLAGGED" ? Colors.orange.withValues(alpha: 0.5) :
                           _uploadController.finalstatus.value == "APPROVED" ? Colors.green.withValues(alpha: 0.5) :
                           hasImage
                        ? const Color(0xFFF59E0B)
                        : isDark
                            ? const Color(0xFF30363D)
                            : const Color(0xFFE5E7EB),
                    width: 2,
                  ),
                ),
                child: hasImage
                    ? Stack(
                        fit: StackFit.expand,
                        children: [
                          ClipRRect(
                            borderRadius: BorderRadius.circular(10),
                            child: Image(
                              image: kIsWeb
                                  ? MemoryImage(
                                      _uploadController.pickedImage.value!.bytes!)
                                  : FileImage(io.File(_uploadController
                                      .pickedImage.value!.path!)) as ImageProvider,
                              fit: BoxFit.cover,
                              width: double.infinity,
                            ),
                          ),
                          if (_uploadController.finalstatus.value == "PENDING")
                            Container(
                              color: Colors.black45,
                              child: const Center(child: CircularProgressIndicator()),
                            ),
                          if (_uploadController.finalstatus.value == "REJECTED" || _uploadController.finalstatus.value == "FLAGGED")
                            Container(
                              color: (_uploadController.finalstatus.value == "REJECTED" ? Colors.red : Colors.orange).withValues(alpha: 0.3),
                              child: Center(
                                child: Column(
                                  mainAxisSize: MainAxisSize.min,
                                  children: [
                                    Icon(_uploadController.finalstatus.value == "REJECTED" ? Icons.block : Icons.warning_amber_rounded, color: Colors.white, size: 48),
                                    const SizedBox(height: 8),
                                    Text(_uploadController.finalstatus.value, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                                    if (_uploadController.finalstatusReason.value.isNotEmpty)
                                      Padding(
                                        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                                        child: Text(
                                          _uploadController.finalstatusReason.value,
                                          style: const TextStyle(color: Colors.white, fontSize: 12),
                                          textAlign: TextAlign.center,
                                          maxLines: 3,
                                          overflow: TextOverflow.ellipsis,
                                        ),
                                      ),
                                  ],
                                ),
                              ),
                            ),
                        ],
                      )
                    : Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Icon(
                            Icons.add_photo_alternate_rounded,
                            size: 48,
                            color: const Color(0xFFF59E0B),
                          ),
                          const SizedBox(height: 16),
                          Text(
                            'Upload Community Image',
                            style: GoogleFonts.inter(
                              fontSize: 14,
                              fontWeight: FontWeight.w600,
                              color: isDark
                                  ? Colors.white
                                  : const Color(0xFF0F172A),
                            ),
                          ),
                          const SizedBox(height: 4),
                          Text(
                            'JPEG, PNG, GIF (Max 20MB)',
                            style: GoogleFonts.inter(
                              fontSize: 12,
                              color: isDark
                                  ? Colors.white38
                                  : const Color(0xFF9CA3AF),
                            ),
                          ),
                        ],
                      ),
              ),
            ),
          ],
        ),
      );
    });
  }

