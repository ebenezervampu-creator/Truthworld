      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Publishing channel',
            style: GoogleFonts.inter(
              fontSize: 16,
              fontWeight: FontWeight.w600,
              color: isDark ? Colors.white : const Color(0xFF111827),
            ),
          ),
          const SizedBox(height: 12),
          _buildChannelDropdown(isDark),
        ],
      );
    });
  }

  Widget _buildChannelDropdown(bool isDark) {
    return Obx(() {
      return DropdownButtonFormField<String>(
        value: _uploadController.selectedChannel.value != null
            ? _uploadController.selectedChannel.value!.channelId
            : null,
        decoration: InputDecoration(
          hintText: 'Select a channel',
          prefixIcon: const Icon(
            Icons.account_circle_rounded,
            size: 20,
            color: Color(0xFF3B82F6),
          ),
          filled: true,
          fillColor: isDark ? const Color(0xFF161B22) : Colors.white,
          border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(16),
            borderSide: BorderSide(
              color: isDark ? const Color(0xFF30363D) : const Color(0xFFE5E7EB),
            ),
          ),
          enabledBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(16),
            borderSide: BorderSide(
              color: isDark ? const Color(0xFF30363D) : const Color(0xFFE5E7EB),
            ),
          ),
          focusedBorder: OutlineInputBorder(
            borderRadius: BorderRadius.circular(16),
            borderSide: const BorderSide(color: Color(0xFF3B82F6), width: 2),
          ),
          contentPadding: const EdgeInsets.symmetric(
            horizontal: 16,
            vertical: 16,
          ),
        ),
        dropdownColor: isDark ? const Color(0xFF161B22) : Colors.white,
        style: GoogleFonts.inter(
          fontSize: 14,
          color: isDark ? Colors.white : const Color(0xFF111827),
        ),
        items: _uploadController.channels.map((channel) {
          return DropdownMenuItem<String>(
            value: channel.channelId,
            child: Text(channel.channelName),
          );
        }).toList(),
        onChanged: (String? value) {
          if (value != null) {
            final selected = _uploadController.channels.firstWhere(
              (channel) => channel.channelId == value,
            );
            _uploadController.selectChannel(selected);
            HapticFeedback.lightImpact();
          }
        },
      );
    });
  }

  void _showTermsAndConditionsDialog(bool isDark) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: isDark ? const Color(0xFF161B22) : Colors.white,
        title: Text(
          'Terms and Conditions',
          style: GoogleFonts.inter(
            fontSize: 18,
            fontWeight: FontWeight.w600,
            color: isDark ? Colors.white : const Color(0xFF111827),
          ),
        ),
        content: Text(
          'By uploading, you agree to our terms of service.',
          style: GoogleFonts.inter(
            color: isDark ? Colors.white70 : const Color(0xFF6B7280),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Agree'),
          ),
        ],
      ),
    );
  }

  void showCreatePlaylistModal(bool isDark) {
    final PlaylistController _playlistController = Get.find();
    final TextEditingController playListNameController =
        TextEditingController();
    final colorScheme = Theme.of(context).colorScheme;
    final screenWidth = MediaQuery.of(context).size.width;
    final isTablet = screenWidth > 600;

    Set<String> initialSelected = {}; // no videoId in this screen
    Map<String, ValueNotifier<bool>> selectedNotifiers = {};
    final selectedCountNotifier = ValueNotifier<int>(initialSelected.length);

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      useSafeArea: true,
      enableDrag: true,
      showDragHandle: false,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setModalState) {
            bool isPublic = true;
            return AnimatedContainer(
              duration: const Duration(milliseconds: 300),
              curve: Curves.easeOutCubic,
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.topCenter,
                  end: Alignment.bottomCenter,
                  colors: [
                    colorScheme.background,
                    Colors.black,
                  ],
                ),
                borderRadius: const BorderRadius.only(
                  topLeft: Radius.circular(28),
                  topRight: Radius.circular(28),
                ),
                border: Border(
                  top: BorderSide(
                    color: Colors.white.withValues(alpha: 0.08),
                    width: 1,
                  ),
                ),
                boxShadow: [
                  BoxShadow(
                    color: Colors.black.withValues(alpha: 0.6),
                    blurRadius: 32,
                    offset: const Offset(0, -8),
                    spreadRadius: 0,
                  ),
                ],
              ),
              child: Container(
                constraints: BoxConstraints(
                  maxHeight: MediaQuery.of(context).size.height * 0.9,
                  minHeight: MediaQuery.of(context).size.height * 0.6,
                ),
                padding: EdgeInsets.only(
                  bottom: MediaQuery.of(context).viewInsets.bottom + 24,
                  left: isTablet ? 32 : 24,
                  right: isTablet ? 32 : 24,
                  top: 20,
                ),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Center(
                      child: Container(
                        width: 48,
                        height: 5,
                        decoration: BoxDecoration(
                          color: Colors.white.withValues(alpha: 0.3),
                          borderRadius: BorderRadius.circular(3),
                        ),
                      ),
                    ),
                    const SizedBox(height: 28),
                    Row(
                      children: [
                        Container(
                          padding: const EdgeInsets.all(12),
                          decoration: BoxDecoration(
                            gradient: LinearGradient(
                              colors: [
                                Color(0xFF1DB954).withValues(alpha: 0.2),
                                Color(0xFF106E3A).withValues(alpha: 0.1)
                              ],
                            ),
                            borderRadius: BorderRadius.circular(16),
                            border: Border.all(
                              color: Color(0xFF1DB954).withValues(alpha: 0.3),
                              width: 1,
                            ),
                          ),
                          child: Icon(Icons.playlist_add_rounded,
                              color: Color(0xFF1DB954), size: 24),
                        ),
                        const SizedBox(width: 16),
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                "Create Playlist",
                                style: GoogleFonts.inter(
                                  fontSize: isTablet ? 26 : 22,
                                  fontWeight: FontWeight.w700,
                                  color: Colors.white,
                                  letterSpacing: -0.5,
                                ),
                              ),
                              const SizedBox(height: 2),
                              Text(
                                "Organize your videos into collections",
                                style: GoogleFonts.inter(
                                  fontSize: 14,
                                  fontWeight: FontWeight.w400,
                                  color: Colors.white.withValues(alpha: 0.6),
                                  letterSpacing: 0,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ],
                    ),
                    const SizedBox(height: 32),
                    Container(
                      decoration: BoxDecoration(
                        borderRadius: BorderRadius.circular(20),
                        boxShadow: [
                          BoxShadow(
                            color: Colors.black.withValues(alpha: 0.2),
                            blurRadius: 8,
                            offset: const Offset(0, 2),
                          ),
                        ],
                      ),
                      child: TextField(
                        controller: playListNameController,
                        style: GoogleFonts.inter(
                            color: Colors.white,
                            fontWeight: FontWeight.w500,
                            fontSize: 16),
                        decoration: InputDecoration(
                          labelText: "Playlist Name",
                          labelStyle: GoogleFonts.inter(
                              color: Colors.white.withValues(alpha: 0.7),
                              fontWeight: FontWeight.w400),
                          hintText: "Enter a descriptive name...",
                          hintStyle: GoogleFonts.inter(
                              color: Colors.white.withValues(alpha: 0.4),
                              fontWeight: FontWeight.w400),
                          prefixIcon: Icon(Icons.title_rounded,
                              color: Colors.white.withValues(alpha: 0.6)),
                          border: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(20),
                            borderSide: BorderSide(
                                color: Colors.white.withValues(alpha: 0.3),
                                width: 1.5),
                          ),
                          enabledBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(20),
                            borderSide: BorderSide(
                                color: Colors.white.withValues(alpha: 0.3),
                                width: 1.5),
                          ),
                          focusedBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(20),
                            borderSide:
                                BorderSide(color: Color(0xFF1DB954), width: 2),
                          ),
                          filled: true,
                          fillColor: Colors.grey[900],
                          contentPadding: const EdgeInsets.symmetric(
                              horizontal: 20, vertical: 16),
                        ),
                      ),
                    ),
                    const SizedBox(height: 24),
                    Flexible(
                      child: StreamBuilder<QuerySnapshot>(
                        stream: FirebaseFirestore.instance
                            .collection('videos')
                            .where('ownerId',
                                isEqualTo:
                                    FirebaseAuth.instance.currentUser?.uid ??
                                        '')
                            .snapshots(),
                        builder: (context, snapshot) {
                          if (snapshot.connectionState ==
                              ConnectionState.waiting) {
                            return Center(child: CircularProgressIndicator());
                          }
                          if (!snapshot.hasData ||
                              snapshot.data!.docs.isEmpty) {
                            return Center(child: Text('No videos available'));
                          }
                          final videos = snapshot.data!.docs
                              .map((doc) => Video.fromDocumentSnapshot(doc))
                              .toList();
                          return ListView.separated(
                            shrinkWrap: true,
                            physics: const BouncingScrollPhysics(),
                            itemCount: videos.length,
                            separatorBuilder: (context, index) =>
                                const SizedBox(height: 12),
                            itemBuilder: (context, index) {
                              final video = videos[index];
                              selectedNotifiers.putIfAbsent(
                                  video.id,
                                  () => ValueNotifier<bool>(
                                      initialSelected.contains(video.id)));
                              final notifier = selectedNotifiers[video.id]!;
                              return ValueListenableBuilder<bool>(
                                valueListenable: notifier,
                                builder: (context, isSelected, _) {
                                  return ListTile(
                                    onTap: () {
                                      notifier.value = !isSelected;
                                      selectedCountNotifier.value =
                                          selectedNotifiers.values
                                              .where((n) => n.value)
                                              .length;
                                    },
                                    leading: Image.network(video.thumbnailUrl,
                                        width: 80,
                                        height: 45,
                                        fit: BoxFit.cover),
                                    title: Text(video.title,
                                        style: GoogleFonts.inter(
                                            color: Colors.white)),
                                    trailing: isSelected
                                        ? Icon(Icons.check_circle_rounded,
                                            color: Color(0xFF1DB954))
                                        : null,
                                  );
                                },
                              );
                            },
                          );
                        },
                      ),
                    ),
                    const SizedBox(height: 24),
                    Container(
                      width: double.infinity,
                      decoration: BoxDecoration(
                        borderRadius: BorderRadius.circular(20),
                        gradient: const LinearGradient(
                            colors: [Color(0xFF1DB954), Color(0xFF106E3A)],
                            begin: Alignment.topLeft,
                            end: Alignment.bottomRight),
                        boxShadow: [
                          BoxShadow(
                              color: Color(0xFF1DB954).withValues(alpha: 0.3),
                              blurRadius: 12,
                              offset: const Offset(0, 4))
                        ],
                      ),
                      child: ElevatedButton.icon(
                        style: ElevatedButton.styleFrom(
                            padding: EdgeInsets.symmetric(
                                vertical: isTablet ? 20 : 18, horizontal: 24),
                            backgroundColor: Colors.transparent,
                            shadowColor: Colors.transparent,
                            shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(20))),
                        icon: const Icon(Icons.add_rounded,
                            color: Colors.white, size: 20),
                        label: Text("CREATE PLAYLIST",
                            style: GoogleFonts.inter(
                                fontWeight: FontWeight.w700,
                                fontSize: isTablet ? 17 : 16,
                                color: Colors.white,
                                letterSpacing: 0.5)),
                        onPressed: () {
                          if (playListNameController.text.trim().isEmpty) {
                            Get.snackbar("Missing Information",
                                "Please enter a playlist name",
                                snackPosition: SnackPosition.TOP,
                                backgroundColor: const Color(0xFFEF4444),
                                colorText: Colors.white,
                                borderRadius: 12,
                                margin: const EdgeInsets.all(16),
                                duration: const Duration(seconds: 3),
                                icon: const Icon(Icons.error_outline,
                                    color: Colors.white));
                            return;
                          }

                          List<String> selectedVideoIds = selectedNotifiers
                              .entries
                              .where((entry) => entry.value.value)
                              .map((entry) => entry.key)
                              .toList();

                          _playlistController.createPlayList(
                              playListNameController.text.trim(),
                              isPublic: isPublic,
                              videoIds: selectedVideoIds);

                          playListNameController.clear();
                          Navigator.pop(context);

                          Get.snackbar(
                              "Success", "Playlist created successfully!",
                              snackPosition: SnackPosition.TOP,
                              backgroundColor: const Color(0xFF1DB954),
                              colorText: Colors.white,
                              borderRadius: 12,
                              margin: const EdgeInsets.all(16),
                              duration: const Duration(seconds: 3),
                              icon: const Icon(Icons.check_circle_outline,
                                  color: Colors.white));
                        },
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }
}

