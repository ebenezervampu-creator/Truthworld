  Widget _buildCommunityPublishButton(bool isDark) {
    return Obx(() {
      final canPublish = _canPublishCommunity();
      final isUploading = _uploadController.isUploading.value;

      if (isUploading) {
        return Container(
          width: double.infinity,
          height: 56,
          decoration: BoxDecoration(
            color: isDark ? const Color(0xFF161B22) : Colors.white,
            borderRadius: BorderRadius.circular(14),
            border: Border.all(
              color: const Color(0xFFF59E0B).withValues(alpha: 0.3),
              width: 1.5,
            ),
          ),
          child: Center(
            child: Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                SizedBox(
                  width: 20,
                  height: 20,
                  child: CircularProgressIndicator(
                    strokeWidth: 2,
                    valueColor:
                        AlwaysStoppedAnimation<Color>(Color(0xFFF59E0B)),
                  ),
                ),
                const SizedBox(width: 12),
                Text(
                  'Publishing...',
                  style: GoogleFonts.inter(
                    fontSize: 14,
                    fontWeight: FontWeight.w600,
                    color: const Color(0xFFF59E0B),
                  ),
                ),
              ],
            ),
          ),
        );
      }

      return Container(
        width: double.infinity,
        height: 56,
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(14),
          gradient: canPublish
              ? const LinearGradient(
                  colors: [Color(0xFFF59E0B), Color(0xFFD97706)],
                )
              : null,
          color: canPublish
              ? null
              : isDark
                  ? const Color(0xFF21262D)
                  : const Color(0xFFE5E7EB),
        ),
        child: Material(
          color: Colors.transparent,
          child: InkWell(
            borderRadius: BorderRadius.circular(14),
            onTap: canPublish ? () => _handleCommunityUpload() : null,
            child: Center(
              child: Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(
                    Icons.publish_rounded,
                    size: 20,
                    color: canPublish
                        ? Colors.white
                        : isDark
                            ? Colors.white24
                            : const Color(0xFF9CA3AF),
                  ),
                  const SizedBox(width: 10),
                  Text(
                    'Publish Community Post',
                    style: GoogleFonts.inter(
                      fontSize: 14,
                      fontWeight: FontWeight.w600,
                      color: canPublish
                          ? Colors.white
                          : isDark
                              ? Colors.white24
                              : const Color(0xFF9CA3AF),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      );
    });
  }

  Widget _buildFinalPublishSection(bool isDark) {
    return Container(
      padding: const EdgeInsets.all(32),
      decoration: BoxDecoration(
        color: isDark ? const Color(0xFF161B22) : Colors.white,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(
          color: isDark ? const Color(0xFF30363D) : const Color(0xFFE5E7EB),
          width: 1.5,
        ),
      ),
      child: Column(
        children: [
          Row(
            children: [
              Container(
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  gradient: const LinearGradient(
                    colors: [Color(0xFF10B981), Color(0xFF059669)],
                  ),
                  borderRadius: BorderRadius.circular(14),
                  boxShadow: [
                    BoxShadow(
                      color: const Color(0xFF10B981).withValues(alpha: 0.3),
                      blurRadius: 16,
                      offset: const Offset(0, 4),
                    ),
                  ],
                ),
                child: const Icon(
                  Icons.verified_rounded,
                  size: 28,
                  color: Colors.white,
                ),
              ),
              const SizedBox(width: 20),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      'Ready to Publish',
                      style: GoogleFonts.inter(
                        fontSize: 20,
                        fontWeight: FontWeight.w800,
                        color: isDark ? Colors.white : const Color(0xFF111827),
                        letterSpacing: -0.3,
                      ),
                    ),
                    const SizedBox(height: 6),
                    Text(
                      'Your video will be processed and made available to viewers',
                      style: GoogleFonts.inter(
                        fontSize: 14,
                        color: isDark
                            ? Colors.white.withValues(alpha: 0.75)
                            : const Color(0xFF6B7280),
                        fontWeight: FontWeight.w500,
                        height: 1.4,
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
          const SizedBox(height: 24),
          _buildPublishChecklist(isDark),
          const SizedBox(height: 20),
          Obx(
            () => Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: isDark ? const Color(0xFF1F2937) : Colors.white,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: isDark
                      ? const Color(0xFF374151)
                      : const Color(0xFFE5E7EB),
                ),
              ),
              child: Row(
                children: [
                  Icon(
                    Icons.info_outline_rounded,
                    size: 18,
                    color: const Color(0xFF3B82F6),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      "Thumbnail Status: ${_uploadController.finalstatus.value.toString()}",
                      style: GoogleFonts.inter(
                        fontSize: 13,
                        color: isDark
                            ? Colors.white.withValues(alpha: 0.8)
                            : const Color(0xFF6B7280),
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPublishChecklist(bool isDark) {
    final checks = [
      (
        'Video uploaded',
        _uploadController.videoUrl.value.isNotEmpty,
        Icons.videocam_rounded
      ),
      (
        'Thumbnail added',
        _uploadController.thumbnailUrl.value.isNotEmpty,
        Icons.image_rounded
      ),
      ('Title added', _titleController.text.isNotEmpty, Icons.title_rounded),
      (
        'Description added',
        _descriptionController.text.isNotEmpty,
        Icons.description_rounded
      ),
      (
        'Channel selected',
        _uploadController.selectedChannel.value != null,
        Icons.account_circle_rounded
      ),
    ];

    return Column(
      children: checks.map((check) {
        final (label, isComplete, icon) = check;
        return AnimatedContainer(
          duration: const Duration(milliseconds: 300),
          margin: const EdgeInsets.only(bottom: 10),
          padding: const EdgeInsets.all(14),
          decoration: BoxDecoration(
            color: isComplete
                ? const Color(0xFF10B981).withValues(alpha: 0.1)
                : isDark
                    ? const Color(0xFF1F2937)
                    : const Color(0xFFF9FAFB),
            borderRadius: BorderRadius.circular(12),
            border: Border.all(
              color: isComplete
                  ? const Color(0xFF10B981).withValues(alpha: 0.3)
                  : isDark
                      ? const Color(0xFF374151)
                      : const Color(0xFFE5E7EB),
              width: isComplete ? 2 : 1,
            ),
          ),
          child: Row(
            children: [
              AnimatedContainer(
                duration: const Duration(milliseconds: 300),
                padding: const EdgeInsets.all(6),
                decoration: BoxDecoration(
                  color: isComplete
                      ? const Color(0xFF10B981)
                      : isDark
                          ? const Color(0xFF374151)
                          : const Color(0xFFE5E7EB),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: Icon(
                  isComplete ? Icons.check_rounded : icon,
                  size: 14,
                  color: isComplete
                      ? Colors.white
                      : isDark
                          ? Colors.white.withValues(alpha: 0.4)
                          : const Color(0xFF9CA3AF),
                ),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: Text(
                  label,
                  style: GoogleFonts.inter(
                    fontSize: 14,
                    color: isComplete
                        ? (isDark ? Colors.white : const Color(0xFF111827))
                        : (isDark
                            ? Colors.white.withValues(alpha: 0.6)
                            : const Color(0xFF6B7280)),
                    fontWeight: isComplete ? FontWeight.w600 : FontWeight.w500,
                  ),
                ),
              ),
            ],
          ),
        );
      }).toList(),
    );
  }

