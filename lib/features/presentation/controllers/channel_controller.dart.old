// ==========================================================================
// MODELS AND ENUMS
// ==========================================================================

class ContentValidationResult {
  final bool isValid;
  final String message;
  ContentValidationResult({required this.isValid, required this.message});
}

enum AvailabilityStatus { unknown, checking, available, taken, invalid, error }

extension AvailabilityStatusExtension on AvailabilityStatus {
  Color get color {
    switch (this) {
      case AvailabilityStatus.unknown:
        return Colors.grey;
      case AvailabilityStatus.checking:
        return Colors.orange;
      case AvailabilityStatus.available:
        return Colors.green;
      case AvailabilityStatus.taken:
      case AvailabilityStatus.invalid:
      case AvailabilityStatus.error:
        return Colors.red;
    }
  }

  IconData get icon {
    switch (this) {
      case AvailabilityStatus.unknown:
        return Icons.help_outline;
      case AvailabilityStatus.checking:
        return Icons.hourglass_empty;
      case AvailabilityStatus.available:
        return Icons.check_circle;
      case AvailabilityStatus.taken:
        return Icons.cancel;
      case AvailabilityStatus.invalid:
      case AvailabilityStatus.error:
        return Icons.error;
    }
  }

  String get message {
    switch (this) {
      case AvailabilityStatus.unknown:
        return '';
      case AvailabilityStatus.checking:
        return 'Checking availability...';
      case AvailabilityStatus.available:
        return 'Available!';
      case AvailabilityStatus.taken:
        return 'This name is already taken';
      case AvailabilityStatus.invalid:
        return 'Invalid format';
      case AvailabilityStatus.error:
        return 'Error checking availability';
    }
  }
}

class ImageData {
  final Uint8List bytes;
  final String name;
  final int size;
  final double aspectRatio;

  ImageData({
    required this.bytes,
    required this.name,
    required this.size,
    required this.aspectRatio,
  });
}

// ==========================================================================
// CHANNEL CONTROLLER
// ==========================================================================

class ChannelController extends GetxController
    with GetTickerProviderStateMixin {
  // Dependencies
  final FirebaseStorage _firebaseStorage = FirebaseStorage.instance;
  final FirebaseFirestore _firestore = FirebaseFirestore.instance;
  final FirebaseAuth _auth = FirebaseAuth.instance;
  final Uuid _uuid = Uuid();

  // Profanity Filters
  final ProfanityFilter _profanityFilter = ProfanityFilter();
  late final BadWordFilter _multiLangFilter;

  // Constants
  static const String _channelsCol = 'channels';
  static const String _subsCol = 'subscriptions';
  static const int MAX_CHANNELS_PER_USER = 3;
  static const int DEBOUNCE_DURATION_MS = 500;
  static const int MIN_CHANNEL_NAME_LENGTH = 3;
  static const int MAX_CHANNEL_NAME_LENGTH = 50;
  static const int MIN_CUSTOM_URL_LENGTH = 3;
  static const int MAX_CUSTOM_URL_LENGTH = 30;
  static const int MAX_DESCRIPTION_LENGTH = 1000;
  static const int MAX_TAGS = 10;

  // Animation Controllers
  late AnimationController fadeAnimationController;
  late AnimationController slideAnimationController;
  late AnimationController scaleAnimationController;
  late AnimationController heroAnimationController;

  // Animations
  late Animation<double> fadeAnimation;
  late Animation<Offset> slideAnimation;
  late Animation<double> scaleAnimation;
  late Animation<double> heroAnimation;

  // Reactive State
  RxList<Channel> channels = RxList<Channel>();
  Rx<Channel?> selectedChannel = Rx<Channel?>(null);
  RxBool isSubscribed = false.obs;
  var subscriberCount = 0.obs;
  var isLoading = false.obs;
  var errorMessage = ''.obs;
  var uploadProgress = 0.0.obs;
  final RxString channelNameMessage = ''.obs;

  // Availability Checking
  var channelNameAvailability = Rx<AvailabilityStatus>(
    AvailabilityStatus.unknown,
  );
  var customUrlAvailability = Rx<AvailabilityStatus>(
    AvailabilityStatus.unknown,
  );
  Timer? _channelNameDebounceTimer;
  Timer? _customUrlDebounceTimer;

  // Subscriptions
  StreamSubscription? _subscriptionListener;
  StreamSubscription? _countListener;
  final Map<String, StreamSubscription> _moderationListeners = {};
  List<String> uploadedDocIds = [];

  @override
  void onInit() {
    super.onInit();
    _initializeFilters();
    initializeAnimations();
    // Keep channels RxList in sync with Firestore (only current user's, non-archived channels)
    final user = _auth.currentUser;
    if (user != null) {
      _firestore
          .collection(_channelsCol)
          .where('ownerId', isEqualTo: user.uid)
          .where('isArchived', isNotEqualTo: true)
          .snapshots()
          .listen((snapshot) {
        channels.assignAll(snapshot.docs.map((doc) => Channel.fromDocumentSnapshot(doc)).toList());
      });
    }
  }

  void _initializeFilters() {
    _multiLangFilter = BadWordFilter(
      languages: ['en', 'fa', 'ar', 'tr', 'de', 'fr', 'es', 'ru'],
      includeSensitiveTopics: true,
      matchInsideWords: true,
      censorCharacter: '*',
      caseSensitive: false,
    );
  }

  void initializeAnimations() {
    fadeAnimationController = AnimationController(
      duration: Duration(milliseconds: 800),
      vsync: this,
    );
    slideAnimationController = AnimationController(
      duration: Duration(milliseconds: 600),
      vsync: this,
    );
    scaleAnimationController = AnimationController(
      duration: Duration(milliseconds: 400),
      vsync: this,
    );
    heroAnimationController = AnimationController(
      duration: Duration(milliseconds: 1000),
      vsync: this,
    );

    fadeAnimation = Tween<double>(begin: 0.0, end: 1.0).animate(
      CurvedAnimation(
        parent: fadeAnimationController,
        curve: Curves.easeOutCubic,
      ),
    );
    slideAnimation = Tween<Offset>(begin: Offset(0, 0.3), end: Offset.zero)
        .animate(
          CurvedAnimation(
            parent: slideAnimationController,
            curve: Curves.easeOutBack,
          ),
        );
    scaleAnimation = Tween<double>(begin: 0.8, end: 1.0).animate(
      CurvedAnimation(
        parent: scaleAnimationController,
        curve: Curves.elasticOut,
      ),
    );
    heroAnimation = Tween<double>(begin: 0.0, end: 1.0).animate(
      CurvedAnimation(
        parent: heroAnimationController,
        curve: Curves.easeOutExpo,
      ),
    );
  }

  void startAnimations() {
    fadeAnimationController.forward();
    Future.delayed(
      Duration(milliseconds: 200),
      () => slideAnimationController.forward(),
    );
    Future.delayed(
      Duration(milliseconds: 400),
      () => scaleAnimationController.forward(),
    );
    Future.delayed(
      Duration(milliseconds: 600),
      () => heroAnimationController.forward(),
    );
  }

  @override
  void onClose() {
    _subscriptionListener?.cancel();
    _countListener?.cancel();
    fadeAnimationController.dispose();
    slideAnimationController.dispose();
    scaleAnimationController.dispose();
    heroAnimationController.dispose();
    _channelNameDebounceTimer?.cancel();
    _customUrlDebounceTimer?.cancel();
    for (var sub in _moderationListeners.values) {
      sub.cancel();
    }
    _moderationListeners.clear();
    super.onClose();
  }

  // ==========================================================================
  // CONTENT VALIDATION
  // ==========================================================================

  Future<ContentValidationResult> validateContent(
    String text, {
    String fieldName = 'Content',
    bool checkPhoneNumbers = false,
  }) async {
    if (text.trim().isEmpty) {
      return ContentValidationResult(
        isValid: false,
        message: '$fieldName cannot be empty',
      );
    }

    String normalized = text.trim();

    if (_profanityFilter.hasProfanity(normalized)) {
      return ContentValidationResult(
        isValid: false,
        message:
            'Your $fieldName contains inappropriate language. Please use respectful words.',
      );
    }

    String filteredText = _multiLangFilter.filterText(normalized);
    if (filteredText != normalized) {
      return ContentValidationResult(
        isValid: false,
        message: 'Your $fieldName contains inappropriate or offensive content.',
      );
    }

    bool containsBadWord = await SafeText.containsBadWord(
      text: normalized,
      extraWords: _getExtraOffensiveWords(),
    );

    if (containsBadWord) {
      return ContentValidationResult(
        isValid: false,
        message: 'Your $fieldName contains inappropriate language.',
      );
    }

    if (checkPhoneNumbers) {
      bool containsPhone = await SafeText.containsPhoneNumber(
        text: normalized,
        minLength: 7,
        maxLength: 15,
      );
      if (containsPhone) {
        return ContentValidationResult(
          isValid: false,
          message:
              'Your $fieldName contains a phone number. Please remove personal information.',
        );
      }
    }

    if (_hasProhibitedPatterns(normalized) ||
        _hasExcessiveRepetition(normalized) ||
        _hasSuspiciousUrls(normalized) ||
        _hasInappropriateEmojis(text)) {
      return ContentValidationResult(
        isValid: false,
        message: 'Your $fieldName contains prohibited content.',
      );
    }

    return ContentValidationResult(isValid: true, message: 'Valid');
  }

  List<String> _getExtraOffensiveWords() => [
    'xxx',
    'nsfw',
    'porn',
    'sex',
    'nude',
    'explicit',
    'nazi',
    'terrorist',
    'racist',
    'cocaine',
    'heroin',
    'meth',
    'kill',
    'murder',
    'suicide',
  ];

  bool _hasProhibitedPatterns(String text) {
    final patterns = [
      r'(pornhub|xvideos|xhamster|onlyfans|chaturbate)',
      r'(click here|free money|buy now|limited offer|act now)',
      r'(bit\.ly|tinyurl|goo\.gl)',
      r'\b(18\+|21\+|adult only|mature content)\b',
    ];
    return patterns.any((p) => RegExp(p, caseSensitive: false).hasMatch(text));
  }

  bool _hasExcessiveRepetition(String text) =>
      RegExp(r'(.)\1{3,}').hasMatch(text);

  bool _hasSuspiciousUrls(String text) {
    final patterns = [
      r'bit\.ly',
      r'tinyurl',
      r'free.*download',
      r'click.*here',
      r'\d+\s*(dollars?|usd|€|£)',
    ];
    return patterns.any((p) => RegExp(p, caseSensitive: false).hasMatch(text));
  }

  bool _hasInappropriateEmojis(String text) {
    final emojis = [
      '🍆',
      '🍑',
      '💦',
      '🔞',
      '💋',
      '👅',
      '💊',
      '💉',
      '🚬',
      '🔫',
      '🔪',
      '💣',
    ];
    return emojis.any((e) => text.contains(e));
  }

  bool isChannelNameApproved(String name) =>
      !_profanityFilter.hasProfanity(name.toLowerCase());

  Future<ContentValidationResult> validateTags(List<String> tags) async {
    if (tags.isEmpty) {
      return ContentValidationResult(
        isValid: false,
        message: 'Please add at least one tag',
      );
    }
    if (tags.length > MAX_TAGS) {
      return ContentValidationResult(
        isValid: false,
        message: 'Maximum $MAX_TAGS tags allowed',
      );
    }
    for (String tag in tags) {
      final result = await validateContent(tag, fieldName: 'Tag');
      if (!result.isValid) {
        return ContentValidationResult(
          isValid: false,
          message: 'Tag "$tag" is invalid: ${result.message}',
        );
      }
    }
    return ContentValidationResult(isValid: true, message: 'Valid');
  }

  // ==========================================================================
  // AVAILABILITY CHECKING
  // ==========================================================================

  void checkChannelNameAvailability(String channelName) {
    _channelNameDebounceTimer?.cancel();
    channelNameAvailability.value = AvailabilityStatus.checking;

    if (channelName.trim().isEmpty) {
      channelNameAvailability.value = AvailabilityStatus.unknown;
      channelNameMessage.value = '';
      return;
    }

    if (channelName.trim().length < MIN_CHANNEL_NAME_LENGTH) {
      channelNameAvailability.value = AvailabilityStatus.invalid;
      channelNameMessage.value =
          'Name must be at least $MIN_CHANNEL_NAME_LENGTH characters';
      return;
    }

    if (channelName.trim().length > MAX_CHANNEL_NAME_LENGTH) {
      channelNameAvailability.value = AvailabilityStatus.invalid;
      channelNameMessage.value =
          'Name cannot exceed $MAX_CHANNEL_NAME_LENGTH characters';
      return;
    }

    _channelNameDebounceTimer = Timer(
      Duration(milliseconds: DEBOUNCE_DURATION_MS),
      () => _performChannelNameAvailabilityCheck(channelName.trim()),
    );
  }

  Future<void> _performChannelNameAvailabilityCheck(String channelName) async {
    try {
      final contentCheck = await validateContent(
        channelName,
        fieldName: 'Channel name',
      );
      if (!contentCheck.isValid) {
        channelNameAvailability.value = AvailabilityStatus.invalid;
        channelNameMessage.value = contentCheck.message;
        return;
      }

      final normalizedName = channelName.toLowerCase();
      final querySnapshot = await _firestore
          .collection('channels')
          .where('channelNameLowercase', isEqualTo: normalizedName)
          .where('isArchived', isNotEqualTo: true)
          .limit(1)
          .get();

      if (querySnapshot.docs.isEmpty) {
        channelNameAvailability.value = AvailabilityStatus.available;
        channelNameMessage.value = 'Channel name is available!';
      } else {
        channelNameAvailability.value = AvailabilityStatus.taken;
        channelNameMessage.value = 'This channel name is already taken';
      }
    } catch (e) {
      print('Error checking channel name availability: $e');
      channelNameAvailability.value = AvailabilityStatus.error;
      channelNameMessage.value = 'Error checking availability';
    }
  }

  void checkCustomUrlAvailability(String customUrl) {
    _customUrlDebounceTimer?.cancel();
    customUrlAvailability.value = AvailabilityStatus.checking;

    if (customUrl.trim().isEmpty) {
      customUrlAvailability.value = AvailabilityStatus.unknown;
      return;
    }

    if (customUrl.trim().length < MIN_CUSTOM_URL_LENGTH ||
        customUrl.trim().length > MAX_CUSTOM_URL_LENGTH ||
        !RegExp(r'^[a-zA-Z0-9_-]+$').hasMatch(customUrl.trim())) {
      customUrlAvailability.value = AvailabilityStatus.invalid;
      return;
    }

    _customUrlDebounceTimer = Timer(
      Duration(milliseconds: DEBOUNCE_DURATION_MS),
      () => _performCustomUrlAvailabilityCheck(customUrl.trim()),
    );
  }
  
  Future<void> _performCustomUrlAvailabilityCheck(String customUrl) async {
    try {
      final contentCheck = await validateContent(
        customUrl,
        fieldName: 'Custom URL',
      );
      if (!contentCheck.isValid) {
        customUrlAvailability.value = AvailabilityStatus.invalid;
        return;
      }

      final normalizedUrl = customUrl.toLowerCase();
      final querySnapshot = await _firestore
          .collection('channels')
          .where('customUrlLowercase', isEqualTo: normalizedUrl)
          .where('isArchived', isNotEqualTo: true)
          .limit(1)
          .get();

      customUrlAvailability.value = querySnapshot.docs.isEmpty
          ? AvailabilityStatus.available
          : AvailabilityStatus.taken;
    } catch (e) {
      print('Error checking custom URL availability: $e');
      customUrlAvailability.value = AvailabilityStatus.error;
    }
  }

  // ==========================================================================
  // CHANNEL CREATION
  // ==========================================================================

  Future<bool> createChannel({
    required String channelName,
    required String description,
    required String bannerUrl,
    required String avatarUrl,
    String? customUrl,
    required bool isPublic,
    required String language,
    required List<String> tags,
    String? category,
    String? contactEmail,
    String? websiteUrl,
    Map<String, dynamic>? socialLinks,
    Map<String, dynamic>? brandingSettings,
  }) async {
    try {
      isLoading.value = true;
      uploadProgress.value = 0.0;

      final user = _auth.currentUser;
      if (user == null) {
        _showErrorSnackbar('You must be signed in to create a channel.');
        return false;
      }

      if (!(await _checkUserChannelLimit(user.uid))) {
        _showErrorSnackbar(
          'You can create a maximum of $MAX_CHANNELS_PER_USER channels.',
        );
        return false;
      }

      final nameValidation = await validateContent(
        channelName,
        fieldName: 'Channel name',
      );
      if (!nameValidation.isValid) {
        _showErrorSnackbar(nameValidation.message);
        return false;
      }

      if (description.length > MAX_DESCRIPTION_LENGTH) {
        _showErrorSnackbar(
          'Description cannot exceed $MAX_DESCRIPTION_LENGTH characters.',
        );
        return false;
      }

      final descValidation = await validateContent(
        description,
        fieldName: 'Description',
        checkPhoneNumbers: true,
      );
      if (!descValidation.isValid) {
        _showErrorSnackbar(descValidation.message);
        return false;
      }

      final tagsValidation = await validateTags(tags);
      if (!tagsValidation.isValid) {
        _showErrorSnackbar(tagsValidation.message);
        return false;
      }

      if (category != null && category.isNotEmpty) {
        final categoryValidation = await validateContent(
          category,
          fieldName: 'Category',
        );
        if (!categoryValidation.isValid) {
          _showErrorSnackbar(categoryValidation.message);
          return false;
        }
      }

      if (!(await _validateChannelName(channelName)) ||
          (customUrl != null &&
              customUrl.isNotEmpty &&
              !(await _validateCustomUrl(customUrl)))) {
        return false;
      }

      if (bannerUrl.isEmpty || avatarUrl.isEmpty) {
        _showErrorSnackbar('Banner and avatar images are required.');
        return false;
      }

      final channelId = _uuid.v4();
      final now = Timestamp.now();

      final channel = Channel(
        channelId: channelId,
        channelName: channelName.trim(),
        channelNameLowercase: channelName.trim().toLowerCase(),
        bannerImageUrl: bannerUrl,
        avatarUrl: avatarUrl,
        description: description.trim(),
        ownerId: user.uid,
        createdAt: now,
        updatedAt: now,
        isPublic: isPublic,
        isVerified: false,
        subscriberCount: 0,
        tags: tags,
        language: language,
        customUrl: customUrl?.trim(),
        customUrlLowercase: customUrl?.trim().toLowerCase(),
        moderatorIds: [],
        blockedUserIds: [],
        lastActiveAt: now,
        viewCount: 0,
        videoCount: 0,
        isArchived: false,
        allowComments: true,
        allowSubscriptions: true,
        showSubscriberCount: true,
        category: category,
        contactEmail: contactEmail?.trim(),
        websiteUrl: websiteUrl?.trim(),
        socialLinks: socialLinks,
        featuredVideoIds: [],
        channelTrailer: null,
        monetizationSettings: {
          'enabled': false,
          'adRevenue': false,
          'membershipEnabled': false,
          'superChatEnabled': false,
        },
        brandingSettings:
            brandingSettings ??
            {
              'primaryColor': '#6B46C1',
              'secondaryColor': '#9333EA',
              'bannerStyle': 'default',
            },
        playlistIds: [],
        analyticsSettings: {'publicStats': true, 'detailedAnalytics': false},
        isLive: false,
        liveStreamId: null,
        notificationSettings: {
          'newSubscriber': true,
          'newComment': true,
          'newVideo': true,
        },
      );

        await _firestore
          .collection('channels')
          .doc(channelId)
          .set(channel.toMap());
        uploadProgress.value = 1.0;
        HapticFeedback.mediumImpact();
        _showSuccessSnackbar('Channel created successfully!');
        return true;
    } catch (e) {
      print('Error creating channel: $e');
      _showErrorSnackbar('Failed to create channel: ${e.toString()}');
      return false;
    } finally {
      isLoading.value = false;
      uploadProgress.value = 0.0;
    }
  }

  Future<bool> _checkUserChannelLimit(String userId) async {
    try {
      final querySnapshot = await _firestore
          .collection('channels')
          .where('ownerId', isEqualTo: userId)
          .where('isArchived', isNotEqualTo: true)
          .get();
      return querySnapshot.docs.length < MAX_CHANNELS_PER_USER;
    } catch (e) {
      print('Error checking user channel limit: $e');
      return false;
    }
  }

  Future<bool> _validateChannelName(String channelName) async {
    if (channelName.trim().isEmpty ||
        channelName.trim().length < MIN_CHANNEL_NAME_LENGTH ||
        channelName.trim().length > MAX_CHANNEL_NAME_LENGTH) {
      _showErrorSnackbar(
        'Channel name must be between $MIN_CHANNEL_NAME_LENGTH and $MAX_CHANNEL_NAME_LENGTH characters.',
      );
      return false;
    }

    try {
      final normalizedName = channelName.trim().toLowerCase();
      final querySnapshot = await _firestore
          .collection('channels')
          .where('channelNameLowercase', isEqualTo: normalizedName)
          .where('isArchived', isNotEqualTo: true)
          .limit(1)
          .get();

      if (querySnapshot.docs.isNotEmpty) {
        _showErrorSnackbar('A channel with this name already exists.');
        return false;
      }
      return true;
    } catch (e) {
      print('Error validating channel name: $e');
      _showErrorSnackbar('Error validating channel name.');
      return false;
    }
  }

  Future<bool> _validateCustomUrl(String customUrl) async {
    if (customUrl.trim().length < MIN_CUSTOM_URL_LENGTH ||
        customUrl.trim().length > MAX_CUSTOM_URL_LENGTH ||
        !RegExp(r'^[a-zA-Z0-9_-]+$').hasMatch(customUrl.trim())) {
      _showErrorSnackbar(
        'Custom URL must be $MIN_CUSTOM_URL_LENGTH-$MAX_CUSTOM_URL_LENGTH characters and contain only letters, numbers, hyphens, and underscores.',
      );
      return false;
    }

    try {
      final normalizedUrl = customUrl.trim().toLowerCase();
      final querySnapshot = await _firestore
          .collection('channels')
          .where('customUrlLowercase', isEqualTo: normalizedUrl)
          .where('isArchived', isNotEqualTo: true)
          .limit(1)
          .get();

      if (querySnapshot.docs.isNotEmpty) {
        _showErrorSnackbar('This custom URL is already taken.');
        return false;
      }
      return true;
    } catch (e) {
      print('Error validating custom URL: $e');
      _showErrorSnackbar('Error validating custom URL.');
      return false;
    }
  }

  Future<String?> uploadImage(
    PlatformFile file,
    String folder,
    String userId, {
    Function(double)? onProgress,
  }) async {
    try {
      final fileName = '${_uuid.v4()}.${file.extension}';
      final ref = _firebaseStorage.ref().child(
        'channels/$folder/$userId/$fileName',
      );
      final metadata = SettableMetadata(contentType: 'image/${file.extension}');
      final uploadTask = ref.putData(file.bytes!, metadata);

      uploadTask.snapshotEvents.listen((snapshot) {
        final progress = snapshot.bytesTransferred / snapshot.totalBytes;
        onProgress?.call(progress);
      });

      final snapshot = await uploadTask;
      final docId = fileName;
      uploadedDocIds.add(docId);

      final subscription = FirebaseFirestore.instance
          .collection("image_status")
          .doc(docId)
          .snapshots()
          .listen((docSnapshot) {
            if (docSnapshot.exists) {
              final status = docSnapshot.data()?['status'] ?? "PENDING";
              final mappedStatus = status.toString().startsWith("REJECT")
                  ? "REJECTED"
                  : status.toString().startsWith("FLAG")
                  ? "REVIEW"
                  : status.toString().startsWith("APPROVE")
                  ? "APPROVED"
                  : "PENDING";
              print("[$folder] Moderation of $docId: $mappedStatus");
            }
          });

      _moderationListeners[docId] = subscription;
      return await snapshot.ref.getDownloadURL();
    } catch (e) {
      print('Error uploading image: $e');
      return null;
    }
  }

  // ==========================================================================
  // CHANNEL MANAGEMENT
  // ==========================================================================

  

  Future<bool> archiveChannel(String channelId) async {
    try {
      await _firestore.collection('channels').doc(channelId).update({
        'isArchived': true,
        'updatedAt': Timestamp.now(),
      });
      channels.removeWhere((channel) => channel.channelId == channelId);
      _showSuccessSnackbar('Channel archived successfully.');
      return true;
    } catch (e) {
      print('Error archiving channel: $e');
      _showErrorSnackbar('Failed to archive channel.');
      return false;
    }
  }

  Future<bool> updateChannel(
    String channelId,
    Map<String, dynamic> updates,
  ) async {
    try {
      if (updates.containsKey('channelName')) {
        final validation = await validateContent(
          updates['channelName'],
          fieldName: 'Channel name',
        );
        if (!validation.isValid) {
          _showErrorSnackbar(validation.message);
          return false;
        }
      }

      if (updates.containsKey('description')) {
        final validation = await validateContent(
          updates['description'],
          fieldName: 'Description',
          checkPhoneNumbers: true,
        );
        if (!validation.isValid) {
          _showErrorSnackbar(validation.message);
          return false;
        }
      }

      if (updates.containsKey('tags')) {
        final validation = await validateTags(updates['tags']);
        if (!validation.isValid) {
          _showErrorSnackbar(validation.message);
          return false;
        }
      }

      updates['updatedAt'] = Timestamp.now();
      await _firestore.collection('channels').doc(channelId).update(updates);

      final index = channels.indexWhere(
        (channel) => channel.channelId == channelId,
      );
      if (index != -1) {
        final doc = await _firestore
            .collection('channels')
            .doc(channelId)
            .get();
        if (doc.exists) {
          channels[index] = Channel.fromDocumentSnapshot(doc);
        }
      }

      _showSuccessSnackbar('Channel updated successfully.');
      return true;
    } catch (e) {
      print('Error updating channel: $e');
      _showErrorSnackbar('Failed to update channel.');
      return false;
    }
  }

  Future<void> updateChannelWithImages({
    required String channelId,
    required String name,
    required String description,
    PlatformFile? newAvatar,
    PlatformFile? newBanner,
  }) async {
    isLoading.value = true;
    try {
      final nameValidation = await validateContent(
        name,
        fieldName: 'Channel name',
      );
      final descValidation = await validateContent(
        description,
        fieldName: 'Description',
        checkPhoneNumbers: true,
      );

      if (!nameValidation.isValid) {
        _showErrorSnackbar(nameValidation.message);
        return;
      }
      if (!descValidation.isValid) {
        _showErrorSnackbar(descValidation.message);
        return;
      }

      final channelRef = _firestore.collection(_channelsCol).doc(channelId);
      final currentDoc = await channelRef.get();
      if (!currentDoc.exists)
        throw Exception("Channel does not exist to update.");

      final currentData = currentDoc.data() as Map<String, dynamic>;
      Map<String, dynamic> updateData = {
        'channelName': name,
        'channelNameLowercase': name.toLowerCase(),
        'description': description,
      };

      if (newAvatar != null && newAvatar.bytes != null) {
        if (currentData['avatarUrl'] != null &&
            (currentData['avatarUrl'] as String).isNotEmpty) {
          await _firebaseStorage
              .refFromURL(currentData['avatarUrl'])
              .delete()
              .catchError(
                (e) => print("Info: Could not delete old avatar. $e"),
              );
        }
        final avatarRef = _firebaseStorage.ref().child(
          'channel_avatars/${_uuid.v4()}_${newAvatar.name}',
        );
        final avatarMetadata = SettableMetadata(contentType: 'image/${newAvatar.name.split('.').last}');
        final avatarSnapshot = await avatarRef.putData(newAvatar.bytes!, avatarMetadata);
        updateData['avatarUrl'] = await avatarSnapshot.ref.getDownloadURL();
      }

      if (newBanner != null && newBanner.bytes != null) {
        if (currentData['bannerImageUrl'] != null &&
            (currentData['bannerImageUrl'] as String).isNotEmpty) {
          await _firebaseStorage
              .refFromURL(currentData['bannerImageUrl'])
              .delete()
              .catchError(
                (e) => print("Info: Could not delete old banner. $e"),
              );
        }
        final bannerRef = _firebaseStorage.ref().child(
          'channel_banners/${_uuid.v4()}_${newBanner.name}',
        );
        final bannerMetadata = SettableMetadata(contentType: 'image/${newBanner.name.split('.').last}');
        final bannerSnapshot = await bannerRef.putData(newBanner.bytes!, bannerMetadata);
        updateData['bannerImageUrl'] = await bannerSnapshot.ref
            .getDownloadURL();
      }

      await channelRef.update(updateData);
      _showSuccessSnackbar("Channel updated successfully!");
    } catch (e) {
      _showErrorSnackbar("Failed to update channel: $e");
    } finally {
      isLoading.value = false;
    }
  }

  Future<bool> addModerator(String channelId, String userId) async {
    try {
      await _firestore.collection('channels').doc(channelId).update({
        'moderatorIds': FieldValue.arrayUnion([userId]),
        'updatedAt': Timestamp.now(),
      });
      _showSuccessSnackbar('Moderator added successfully.');
      return true;
    } catch (e) {
      print('Error adding moderator: $e');
      _showErrorSnackbar('Failed to add moderator.');
      return false;
    }
  }

  Future<bool> removeModerator(String channelId, String userId) async {
    try {
      await _firestore.collection('channels').doc(channelId).update({
        'moderatorIds': FieldValue.arrayRemove([userId]),
        'updatedAt': Timestamp.now(),
      });
      _showSuccessSnackbar('Moderator removed successfully.');
      return true;
    } catch (e) {
      print('Error removing moderator: $e');
      _showErrorSnackbar('Failed to remove moderator.');
      return false;
    }
  }

  Future<bool> subscribeToChannel(String channelId) async {
    try {
      final user = _auth.currentUser;
      if (user == null) {
        _showErrorSnackbar('You must be signed in to subscribe.');
        return false;
      }

      await _firestore.runTransaction((transaction) async {
        final channelRef = _firestore.collection('channels').doc(channelId);
        final channelDoc = await transaction.get(channelRef);

        if (!channelDoc.exists) throw Exception('Channel not found');

        final currentCount = channelDoc.data()?['subscriberCount'] ?? 0;

        transaction.update(channelRef, {
          'subscriberCount': currentCount + 1,
          'updatedAt': Timestamp.now(),
        });

        final subscriptionRef = _firestore
            .collection('subscriptions')
            .doc('${user.uid}_$channelId');
        transaction.set(subscriptionRef, {
          'userId': user.uid,
          'channelId': channelId,
          'subscribedAt': Timestamp.now(),
        });
      });

      HapticFeedback.lightImpact();
      _showSuccessSnackbar('Subscribed successfully!');
      return true;
    } catch (e) {
      print('Error subscribing to channel: $e');
      _showErrorSnackbar('Failed to subscribe.');
      return false;
    }
  }

  Future<bool> unsubscribeFromChannel(String channelId) async {
    try {
      final user = _auth.currentUser;
      if (user == null) {
        _showErrorSnackbar('You must be signed in to unsubscribe.');
        return false;
      }

      await _firestore.runTransaction((transaction) async {
        final channelRef = _firestore.collection('channels').doc(channelId);
        final channelDoc = await transaction.get(channelRef);

        if (!channelDoc.exists) throw Exception('Channel not found');

        final currentCount = channelDoc.data()?['subscriberCount'] ?? 0;

        transaction.update(channelRef, {
          'subscriberCount': currentCount > 0 ? currentCount - 1 : 0,
          'updatedAt': Timestamp.now(),
        });

        final subscriptionRef = _firestore
            .collection('subscriptions')
            .doc('${user.uid}_$channelId');
        transaction.delete(subscriptionRef);
      });

      HapticFeedback.lightImpact();
      _showSuccessSnackbar('Unsubscribed successfully.');
      return true;
    } catch (e) {
      print('Error unsubscribing from channel: $e');
      _showErrorSnackbar('Failed to unsubscribe.');
      return false;
    }
  }

  Future<void> toggleSubscription(String channelId) async {
    final userId = _auth.currentUser?.uid;
    if (userId == null) {
      Get.snackbar("Error", "User not authenticated.");
      return;
    }

    final subscriptionDocId = '${userId}_$channelId';
    final subscriptionRef = _firestore
        .collection(_subsCol)
        .doc(subscriptionDocId);

    try {
      final docSnapshot = await subscriptionRef.get();
      if (docSnapshot.exists) {
        await unsubscribeFromChannel(channelId);
      } else {
        await subscribeToChannel(channelId);
      }
    } catch (e) {
      print(e);
      Get.snackbar("Error", "Failed to toggle subscription: $e");
    }
  }

  void listenSubscription(String channelId) {
    final userId = _auth.currentUser?.uid;
    if (userId == null) {
      isSubscribed.value = false;
      return;
    }

    final subscriptionDocId = '${userId}_$channelId';
    _subscriptionListener?.cancel();
    _subscriptionListener = _firestore
        .collection(_subsCol)
        .doc(subscriptionDocId)
        .snapshots()
        .listen((doc) {
          isSubscribed.value = doc.exists;
        });
  }

  void fetchSubscriberCount(String channelId) {
    isLoading.value = true;
    _countListener?.cancel();
    _countListener = _firestore
        .collection(_subsCol)
        .where('channelId', isEqualTo: channelId)
        .snapshots()
        .listen(
          (snapshot) {
            subscriberCount.value = snapshot.docs.length;
            isLoading.value = false;
          },
          onError: (error) {
            errorMessage.value = error.toString();
            isLoading.value = false;
          },
        );
  }

  Future<bool> blockUser(String channelId, String userId) async {
    try {
      await _firestore.collection('channels').doc(channelId).update({
        'blockedUserIds': FieldValue.arrayUnion([userId]),
        'updatedAt': Timestamp.now(),
      });
      _showSuccessSnackbar('User blocked successfully.');
      return true;
    } catch (e) {
      print('Error blocking user: $e');
      _showErrorSnackbar('Failed to block user.');
      return false;
    }
  }

  Future<bool> unblockUser(String channelId, String userId) async {
    try {
      await _firestore.collection('channels').doc(channelId).update({
        'blockedUserIds': FieldValue.arrayRemove([userId]),
        'updatedAt': Timestamp.now(),
      });
      _showSuccessSnackbar('User unblocked successfully.');
      return true;
    } catch (e) {
      print('Error unblocking user: $e');
      _showErrorSnackbar('Failed to unblock user.');
      return false;
    }
  }

  // ==========================================================================
  // UTILITY METHODS
  // ==========================================================================

  void _showErrorSnackbar(String message) {
    Get.snackbar(
      'Error',
      message,
      snackPosition: SnackPosition.BOTTOM,
      backgroundColor: Colors.red.shade600,
      colorText: Colors.white,
      margin: EdgeInsets.all(16),
      borderRadius: 12,
      icon: Icon(Icons.error_outline, color: Colors.white),
      duration: Duration(seconds: 4),
    );
  }

  void _showSuccessSnackbar(String message) {
    Get.snackbar(
      'Success',
      message,
      snackPosition: SnackPosition.BOTTOM,
      backgroundColor: Colors.green.shade600,
      colorText: Colors.white,
      margin: EdgeInsets.all(16),
      borderRadius: 12,
      icon: Icon(Icons.check_circle_outline, color: Colors.white),
      duration: Duration(seconds: 3),
    );
  }

  void resetAvailabilityStatus() {
    channelNameAvailability.value = AvailabilityStatus.unknown;
    customUrlAvailability.value = AvailabilityStatus.unknown;
    channelNameMessage.value = '';
  }

  Channel? getChannelById(String channelId) {
    try {
      return channels.firstWhere((channel) => channel.channelId == channelId);
    } catch (e) {
      return null;
    }
  }

  int get userChannelCount => channels.length;
  bool get canCreateMoreChannels => userChannelCount < MAX_CHANNELS_PER_USER;

  Stream<List<Channel>> get channelStream => _firestore
      .collection(_channelsCol)
      .snapshots()
      .map(
        (snapshot) => snapshot.docs
            .map((doc) => Channel.fromDocumentSnapshot(doc))
            .toList(),
      );

  void fetchChannel(String channelId) {
    isLoading.value = true;
    _firestore
        .collection(_channelsCol)
        .doc(channelId)
        .snapshots()
        .listen(
          (snapshot) {
            if (snapshot.exists) {
              selectedChannel.value = Channel.fromDocumentSnapshot(snapshot);
              errorMessage.value = '';
            } else {
              errorMessage.value = 'No channel found';
            }
            isLoading.value = false;
          },
          onError: (error) {
            errorMessage.value = error.toString();
            isLoading.value = false;
          },
        );
  }

  Future<void> shareChannel(String channelId) async {
    try {
      String channelUrl = 'https://www.towervsp.com/channel/$channelId';
      await Share.share(
        'Check out this channel: $channelUrl',
        subject: 'Awesome channel!',
      );
    } catch (e) {
      print('Error sharing channel: $e');
    }
  }
}

