rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Helper function =====
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true && request.auth.token.email_verified == true;
    }

    // Strict ownership validation for existing assets (prevents deleting or overwriting unowned files)
    function isResourceOwner() {
      return isSignedIn() && (
        isAdmin() ||
        (resource != null &&
         resource.metadata != null &&
         'uploaderId' in resource.metadata &&
         resource.metadata['uploaderId'] == request.auth.uid)
      );
    }

    // Allows creating new resources or updating resources owned by caller
    function isOwnerOrNew() {
      return isSignedIn() && (
        isAdmin() ||
        resource == null ||
        (resource.metadata != null &&
         'uploaderId' in resource.metadata &&
         resource.metadata['uploaderId'] == request.auth.uid)
      );
    }

    // Ensure client cannot forge another user's uploaderId metadata and enforces uploaderId presence
    function isUploaderClaimValid() {
      return isSignedIn() && (
        isAdmin() ||
        (request.resource != null &&
         request.resource.metadata != null &&
         'uploaderId' in request.resource.metadata &&
         request.resource.metadata['uploaderId'] == request.auth.uid)
      );
    }

    // ===== Firestore-backed video ownership (audit C1 / C4) =====
    // Storage paths under videos/{videoId}/ and resolutions/{videoId}/ must be
    // tied to the Firestore video doc. Without this, any signed-in user could
    // write a NEW file under someone else's video id (resource == null passes
    // isOwnerOrNew) and the resolution trigger would publish it as that video.
    function isFirestoreVideoOwner(videoId) {
      let path = /databases/(default)/documents/videos/$(videoId);
      return isSignedIn() && (
        isAdmin() ||
        (firestore.exists(path) && (
          firestore.get(path).data.get('ownerId', '') == request.auth.uid ||
          firestore.get(path).data.get('userId', '') == request.auth.uid ||
          firestore.get(path).data.get('uploaderId', '') == request.auth.uid
        ))
      );
    }

    // Video exists and is not private / draft (mirrors the Firestore videos get rule).
    function isFirestoreVideoPublic(videoId) {
      let path = /databases/(default)/documents/videos/$(videoId);
      return firestore.exists(path) &&
        !(firestore.get(path).data.get('visibility', 'public') in ['Private', 'private', 'PRIVATE', 'draft', 'Draft', 'private_draft']);
    }

    // Validate extension and enforce strict file size caps
    function isValidThumbnail() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)')
        && request.resource.size <= 2 * 1024 * 1024; // 2MB max for video thumbnails (matches YouTube limit)
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)')
        && request.resource.size <= 15 * 1024 * 1024; // 15MB max for images (SVG strictly prohibited to eliminate Stored XSS)
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size <= 1024 * 1024 * 1024; // 1GB max for videos
    }

    function isValidKycDocument() {
      return (request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') || request.resource.contentType == 'application/pdf')
        && request.resource.size <= 10 * 1024 * 1024; // 10MB max for KYC verification documents
    }

    // ================================
    // CHANNEL USER FILES
    // ================================
    match /channels/{folder}/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && 
        (folder == 'avatars' || folder == 'banners' ? isValidImage() : (isValidImage() || isValidVideo()));
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /channels/avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /channels/banners/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ================================
    // USER AVATARS & BANNERS & PROFILES
    // ================================
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /banners/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && (isValidImage() || isValidVideo() || isValidKycDocument());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /avatars/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // CHANNEL AVATARS
    // ================================
    match /channel_avatars/{allPaths=**} {
      allow read: if true; // public avatars
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // CHANNEL BANNERS
    // ================================
    match /channel_banners/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // COMMUNITY IMAGES
    // ================================
    match /community_images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // THUMBNAILS (Public visual media for universal sharing & CDN caching)
    // ================================
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidThumbnail() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // TOPICS & PLAYLISTS VISUAL MEDIA
    // ================================
    match /topics/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    match /playlists/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // CHAPTERS & CLAIM CHAPTERS (Public visual media)
    // ================================
    match /chapters/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // STORYBOARDS (Video Timeline Scrub Previews)
    // ================================
    match /storyboards/{allPaths=**} {
      allow read: if true;
      allow write: if false; // System pipeline only
      allow delete: if false;
    }

    // Video Chapters & Claim Chapters Frames / Visual Badges (Public visual media under video tree)
    match /videos/{videoId}/chapters/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew() && isFirestoreVideoOwner(videoId);
      allow delete: if isResourceOwner();
    }

    // Video Subtitles & Closed Captions under video tree (Public Web & Accessibility Standards: WCAG 2.1 AA)
    match /videos/{videoId}/subtitles/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (
        request.resource.contentType.matches('text/(vtt|plain)') ||
        request.resource.contentType.matches('application/json')
      ) && isUploaderClaimValid() && isOwnerOrNew() && isFirestoreVideoOwner(videoId);
      allow delete: if isResourceOwner();
    }

    // Video Transcripts under video tree (Public Web & Accessibility Standards: WCAG 2.1 AA)
    match /videos/{videoId}/transcripts/{allPaths=**} {
      allow read: if true;
      allow write: if false; // System pipeline only
      allow delete: if false;
    }

    // ================================
    // RAW ORIGINAL VIDEOS (Restricted to creator owner & admin — blocks draft leaks)
    // ================================
    // Original video uploads: videos/{videoId}/original.mp4
    // Raw master uploads are strictly protected; viewers stream transcoded resolutions
    match /videos/{videoId}/{allPaths=**} {
      allow read: if isSignedIn() && (isResourceOwner() || isAdmin());
      allow write: if isSignedIn() && isUploaderClaimValid() && isOwnerOrNew() && isFirestoreVideoOwner(videoId)
        && (
          (request.resource.contentType.matches('video/(mp4|webm|quicktime|x-matroska)') && request.resource.size <= 1024 * 1024 * 1024) ||
          (request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') && request.resource.size <= 15 * 1024 * 1024) ||
          (request.resource.contentType.matches('audio/(mp4|mpeg|wav|aac|ogg|webm)') && request.resource.size <= 100 * 1024 * 1024) ||
          (request.resource.contentType.matches('text/(vtt|plain)') && request.resource.size <= 10 * 1024 * 1024)
        );
      allow delete: if isResourceOwner();
    }

    // Transcripts pipeline storage (Public Web & Accessibility Standards: WCAG 2.1 AA)
    match /transcripts/{allPaths=**} {
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    // ================================
    // TRANSCODED RESOLUTIONS (Adaptive Streaming for In-App & Web Viewers)
    // ================================
    match /resolutions/{videoId}/{allPaths=**} {
      // Public and unlisted videos stream to everyone (web guests included).
      // Private / draft transcodes only to the owner and admins (audit C4).
      // Note: URLs carrying a ?token= download token bypass these rules, so
      // those tokens must also stay out of reach (see resolution_jobs rule).
      allow read: if isFirestoreVideoPublic(videoId) || isFirestoreVideoOwner(videoId);
      allow write: if false; // System pipeline only
      allow delete: if false;
    }

    // ================================
    // SUBTITLES & CLOSED CAPTIONS (Public Web & Accessibility Standards: WCAG 2.1 AA)
    // ================================
    match /subtitles/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    match /audiotracks/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }
    
    match /dubbing_results/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    // ================================
    // DUBBING SOURCE MEDIA UPLOADS
    // ================================
    match /dubbing_uploads/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
        (
          (request.resource.contentType.matches('video/.*') && request.resource.size <= 1024 * 1024 * 1024) ||
          (request.resource.contentType.matches('audio/.*') && request.resource.size <= 250 * 1024 * 1024)
        );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ================================
    // FACT CHECKS
    // ================================
    match /factChecks/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    // Legacy flat video uploads (Restricted to owner & admin)
    match /videos/{videoName} {
      allow read: if isSignedIn() && (isResourceOwner() || isAdmin());
      allow write: if isSignedIn() && isValidVideo() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // AD CAMPAIGNS MEDIA
    // ================================
    match /ad_campaigns_media/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (isValidImage() || isValidVideo()) && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // CREATOR KYC DOCUMENTS (STRICT PRIVATE ACCESS)
    // ================================
    match /kyc_documents/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidKycDocument();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}

