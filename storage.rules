rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Helper function =====
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Strict ownership validation for existing assets (prevents deleting or overwriting unowned files)
    function isResourceOwner() {
      return isSignedIn() && (
        isAdmin() ||
        (resource != null &&
         resource.metadata != null &&
         'uploaderId' in resource.metadata &&
         resource.metadata['uploaderId'] == request.auth.uid)
      );
    }

    // Allows creating new resources or updating resources owned by caller
    function isOwnerOrNew() {
      return isSignedIn() && (
        isAdmin() ||
        resource == null ||
        (resource.metadata != null &&
         'uploaderId' in resource.metadata &&
         resource.metadata['uploaderId'] == request.auth.uid)
      );
    }

    // Ensure client cannot forge another user's uploaderId metadata and enforces uploaderId presence
    function isUploaderClaimValid() {
      return isSignedIn() && (
        isAdmin() ||
        (request.resource != null &&
         request.resource.metadata != null &&
         'uploaderId' in request.resource.metadata &&
         request.resource.metadata['uploaderId'] == request.auth.uid)
      );
    }

    // Validate extension and enforce strict file size caps
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size <= 15 * 1024 * 1024; // 15MB max for images
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size <= 1024 * 1024 * 1024; // 1GB max for videos
    }

    function isValidKycDocument() {
      return (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && request.resource.size <= 10 * 1024 * 1024; // 10MB max for KYC verification documents
    }

    // ================================
    // CHANNEL USER FILES
    // ================================
    match /channels/{folder}/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && 
        (folder == 'avatars' || folder == 'banners' ? isValidImage() : (isValidImage() || isValidVideo()));
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /channels/avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /channels/banners/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ================================
    // USER AVATARS & BANNERS & PROFILES
    // ================================
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /banners/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && (isValidImage() || isValidVideo() || isValidKycDocument());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /avatars/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // CHANNEL AVATARS
    // ================================
    match /channel_avatars/{fileName} {
      allow read: if true; // public avatars
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // CHANNEL BANNERS
    // ================================
    match /channel_banners/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // COMMUNITY IMAGES
    // ================================
    match /community_images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // THUMBNAILS
    // ================================
    match /thumbnails/{fileName} {
      allow read: if true; // or restrict to signed in users
      allow write: if isSignedIn() && isValidImage() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // VIDEOS (nested pipeline structure)
    // ================================
    // Original video uploads: videos/{videoId}/original.mp4
    // Pipeline outputs: videos/{videoId}/transcript.json, translations/, audio/, etc.
    match /videos/{videoId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isUploaderClaimValid() && isOwnerOrNew()
        && (
          (request.resource.contentType.matches('video/.*') && request.resource.size <= 1024 * 1024 * 1024) ||
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 15 * 1024 * 1024) ||
          (request.resource.contentType.matches('audio/.*') && request.resource.size <= 100 * 1024 * 1024) ||
          (request.resource.contentType.matches('application/.*|text/.*') && request.resource.size <= 50 * 1024 * 1024)
        );
      allow delete: if isResourceOwner();
    }

    // ================================
    // TRANSCODED RESOLUTIONS
    // ================================
    match /resolutions/{videoId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // System only
      allow delete: if false;
    }

    // ================================
    // SUBTITLES & DUBBING
    // ================================
    match /subtitles/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    match /audiotracks/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }
    
    match /dubbing_results/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    // ================================
    // FACT CHECKS
    // ================================
    match /factChecks/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    // Legacy flat video uploads (backward compat)
    match /videos/{videoName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidVideo() && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // AD CAMPAIGNS MEDIA
    // ================================
    match /ad_campaigns_media/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (isValidImage() || isValidVideo()) && isUploaderClaimValid() && isOwnerOrNew();
      allow delete: if isResourceOwner();
    }

    // ================================
    // CREATOR KYC DOCUMENTS (STRICT PRIVATE ACCESS)
    // ================================
    match /kyc_documents/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidKycDocument();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}

