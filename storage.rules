rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Helper function =====
    function isSignedIn() {
      return request.auth != null;
    }

    // Validate extension
    function isValidImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    // ================================
    // CHANNEL USER FILES
    // ================================
    match /channels/{folder}/{userId}/{fileName} {
      allow read: if true; // or restrict if needed
      allow write, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ================================
    // CHANNEL AVATARS
    // ================================
    match /channel_avatars/{fileName} {
      allow read: if true; // public avatars
      allow write: if isSignedIn() && isValidImage();
      allow delete: if isSignedIn() && resource.metadata['uploaderId'] == request.auth.uid;
    }

    // ================================
    // CHANNEL BANNERS
    // ================================
    match /channel_banners/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
      allow delete: if isSignedIn() && resource.metadata['uploaderId'] == request.auth.uid;
    }

    // ================================
    // COMMUNITY IMAGES
    // ================================
    match /community_images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
      allow delete: if isSignedIn() && resource.metadata['uploaderId'] == request.auth.uid;
    }

    // ================================
    // THUMBNAILS
    // ================================
    match /thumbnails/{fileName} {
      allow read: if true; // or restrict to signed in users
      allow write: if isSignedIn() && isValidImage();
      allow delete: if isSignedIn() && resource.metadata['uploaderId'] == request.auth.uid;
    }

    // ================================
    // VIDEOS (nested pipeline structure)
    // ================================
    // Original video uploads: videos/{videoId}/original.mp4
    // Pipeline outputs: videos/{videoId}/transcript.json, translations/, audio/, etc.
    match /videos/{videoId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (
        resource == null ||
        request.resource.metadata['uploaderId'] == request.auth.uid ||
        resource.metadata['uploaderId'] == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.metadata['uploaderId'] == request.auth.uid;
    }

    // ================================
    // TRANSCODED RESOLUTIONS
    // ================================
    match /resolutions/{videoId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // System only
      allow delete: if false;
    }

    // ================================
    // SUBTITLES & DUBBING
    // ================================
    match /subtitles/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }
    
    match /dubbing_results/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    // ================================
    // FACT CHECKS
    // ================================
    match /factChecks/{allPaths=**} {
      allow read: if true;
      allow write: if false; 
      allow delete: if false;
    }

    // Legacy flat video uploads (backward compat)
    match /videos/{videoName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidVideo();
      allow delete: if isSignedIn() && resource.metadata['uploaderId'] == request.auth.uid;
    }
  }
}
