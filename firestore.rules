rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    // Helper function to check if user has administrative privileges.
    // Relies strictly on Firebase Auth custom claims, verified bootstrap owner emails, or verified admin_members records.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.isSuperAdmin == true ||
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'hello@truthworld.in' ||
          request.auth.token.email == 'ebenezervampu4@gmail.com'
        )) ||
        (request.auth.token.email != null &&
         request.auth.token.email_verified == true &&
         exists(/databases/$(database)/documents/admin_members/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admin_members/$(request.auth.token.email)).data.status != 'suspended') ||
        (exists(/databases/$(database)/documents/admin_members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_members/$(request.auth.uid)).data.status != 'suspended')
      );
    }

    // Helper function to safely check video document ownership from its data map
    function isVideoDataOwner(data) {
      return ('ownerId' in data && data.ownerId == request.auth.uid) ||
             ('userId' in data && data.userId == request.auth.uid) ||
             ('uploaderId' in data && data.uploaderId == request.auth.uid) ||
             ('channelId' in data && data.channelId != null &&
              exists(/databases/$(database)/documents/channels/$(data.channelId)) &&
              (('ownerId' in get(/databases/$(database)/documents/channels/$(data.channelId)).data &&
                get(/databases/$(database)/documents/channels/$(data.channelId)).data.ownerId == request.auth.uid) ||
               ('userId' in get(/databases/$(database)/documents/channels/$(data.channelId)).data &&
                get(/databases/$(database)/documents/channels/$(data.channelId)).data.userId == request.auth.uid)));
    }

    // Helper function to check if user owns a video (or channel owning the video)
    function isVideoOwner(videoId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/videos/$(videoId)) &&
         isVideoDataOwner(get(/databases/$(database)/documents/videos/$(videoId)).data))
      );
    }

    // Helper function to safely check community post document ownership from its data map
    function isCommunityPostDataOwner(data) {
      return ('ownerId' in data && data.ownerId == request.auth.uid) ||
             ('userId' in data && data.userId == request.auth.uid) ||
             ('channelId' in data && data.channelId != null &&
              exists(/databases/$(database)/documents/channels/$(data.channelId)) &&
              (('ownerId' in get(/databases/$(database)/documents/channels/$(data.channelId)).data &&
                get(/databases/$(database)/documents/channels/$(data.channelId)).data.ownerId == request.auth.uid) ||
               ('userId' in get(/databases/$(database)/documents/channels/$(data.channelId)).data &&
                get(/databases/$(database)/documents/channels/$(data.channelId)).data.userId == request.auth.uid)));
    }

    // Helper function to check if user owns a community post
    function isCommunityPostOwner(postId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/Community/$(postId)) &&
         isCommunityPostDataOwner(get(/databases/$(database)/documents/Community/$(postId)).data)) ||
        (exists(/databases/$(database)/documents/community/$(postId)) &&
         isCommunityPostDataOwner(get(/databases/$(database)/documents/community/$(postId)).data)) ||
        (exists(/databases/$(database)/documents/community_posts/$(postId)) &&
         isCommunityPostDataOwner(get(/databases/$(database)/documents/community_posts/$(postId)).data))
      );
    }

    
    // Channel Handles Collection (Unique handle registry)
    match /channel_handles/{handle} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Hashtags Collection
    match /hashtags/{hashtagId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'videoCount', 'updatedAt', 'lastUsedAt'])
      );
      allow delete: if isAdmin();
    }

    // Channel Drafts Collection
    match /channel_drafts/{draftId} {
      // Allow users to read their own drafts
      allow read: if isAuthenticated() && 
                     (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);
      
      // Allow users to create their own drafts
      allow create: if isAuthenticated() && 
                       (request.resource.data.ownerId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      
      // Allow users to update their own drafts
      allow update: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);
      
      // Allow users to delete their own drafts
      allow delete: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Channel Language Requests Collection
    match /channel_language_requests/{requestId} {
      // Users can read their own language requests, Admins can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Authenticated users can submit a language request
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      // Only admins can update status or delete language requests
      allow update, delete: if isAdmin();
    }
    
    // Channels Collection
    match /channels/{channelId} {
      // Allow anyone to read channels (needed for discovery and collection listing)
      allow read: if true;
      
      // Allow authenticated users to create their own channel without self-verifying, self-monetizing, or setting discount privileges
      allow create: if isAuthenticated() && 
                       (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
                       (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
                       (request.resource.data.ownerId == request.auth.uid ||
                        request.resource.data.userId == request.auth.uid ||
                        isAdmin()) &&
                       (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
                       (!('geminiApproved' in request.resource.data) || request.resource.data.geminiApproved == false) &&
                       (!('trustedModerationBypass' in request.resource.data) || request.resource.data.trustedModerationBypass == false) &&
                       (!('bypassModeration' in request.resource.data) || request.resource.data.bypassModeration == false) &&
                       (!('trustedChannel' in request.resource.data) || request.resource.data.trustedChannel == false) &&
                       (!('trustedBypass' in request.resource.data) || request.resource.data.trustedBypass == false) &&
                       (!('monetizationTier' in request.resource.data) || request.resource.data.monetizationTier == 'none' || request.resource.data.monetizationTier == 'free') &&
                       (!('superchatRevenueTotal' in request.resource.data) || request.resource.data.superchatRevenueTotal == 0) &&
                       (!('adsRevenueTotal' in request.resource.data) || request.resource.data.adsRevenueTotal == 0) &&
                       (!('premiumSubsRevenueTotal' in request.resource.data) || request.resource.data.premiumSubsRevenueTotal == 0) &&
                       (!('membershipRevenueTotal' in request.resource.data) || request.resource.data.membershipRevenueTotal == 0) &&
                       (!('membershipsRevenueTotal' in request.resource.data) || request.resource.data.membershipsRevenueTotal == 0) &&
                       (!('withdrawnRevenueTotal' in request.resource.data) || request.resource.data.withdrawnRevenueTotal == 0) &&
                       (!('walletBalanceUSD' in request.resource.data) || request.resource.data.walletBalanceUSD == 0) &&
                       (!('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0) &&
                       (!('clearedWithdrawableRevenueTotal' in request.resource.data) || request.resource.data.clearedWithdrawableRevenueTotal == 0) &&
                       (!('pendingRevenueTotal' in request.resource.data) || request.resource.data.pendingRevenueTotal == 0) &&
                       (!('strikes' in request.resource.data) || request.resource.data.strikes == 0) &&
                       (!('strikeCount' in request.resource.data) || request.resource.data.strikeCount == 0) &&
                       (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false) &&
                       (!('channelType' in request.resource.data) || request.resource.data.channelType == 'standard' || request.resource.data.channelType == 'none') &&
                       (!('infraConfig' in request.resource.data) || (!('rolloverCreditUSD' in request.resource.data.infraConfig) || request.resource.data.infraConfig.rolloverCreditUSD == 0)) &&
                       (!('isMonetized' in request.resource.data) || request.resource.data.isMonetized == false) &&
                       (!('monetizationEnabled' in request.resource.data) || request.resource.data.monetizationEnabled == false) &&
                       (!('payoutsBlocked' in request.resource.data) || request.resource.data.payoutsBlocked == false) &&
                       (!('fraudReviewFlag' in request.resource.data) || request.resource.data.fraudReviewFlag == false) &&
                       (!('allowAnytimePayout' in request.resource.data) || request.resource.data.allowAnytimePayout == false) &&
                       (!('subscriberCount' in request.resource.data) || request.resource.data.subscriberCount == 0) &&
                       (isAdmin() || (
                         !('dubbingDiscountType' in request.resource.data) &&
                         !('dubbingDiscountPercent' in request.resource.data) &&
                         !('subtitlesDiscountType' in request.resource.data) &&
                         !('subtitlesDiscountPercent' in request.resource.data) &&
                         !('aiDiscounts' in request.resource.data)
                       ));
      
      // Allow owners or admins to update their channels, protecting verification, moderation, financial, and discount fields
      allow update: if isAuthenticated() && (
                       isAdmin() ||
                       ((resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'isVerified', 'geminiApproved', 'status', 'monetizationTier', 'superchatRevenueTotal',
                          'adsRevenueTotal', 'membershipRevenueTotal', 'membershipsRevenueTotal', 'premiumSubsRevenueTotal',
                          'walletBalanceUSD', 'walletBalance', 'withdrawnRevenueTotal',
                          'clearedWithdrawableRevenueTotal', 'pendingRevenueTotal',
                          'infraConfig', 'channelType', 'isMonetized', 'monetizationStatus', 'monetizationEnabled',
                          'payoutsBlocked', 'fraudReviewFlag', 'viewFraudReviewFlag', 'botViewSuspected',
                          'allowAnytimePayout', 'qualifiedViewCount', 'totalWatchTimeMinutes',
                          'subscriberCount', 'ownerId', 'userId', 'createdAt', 'penaltyStatus',
                          'trustScore', 'reputationScore', 'moderationReason', 'metrics',
                          'strikes', 'strikeCount', 'isBanned', 'suspendedAt', 'bannedAt',
                          'trustedModerationBypass', 'bypassModeration', 'trustedChannel', 'trustedBypass',
                          'dubbingDiscountType', 'dubbingDiscountPercent',
                          'subtitlesDiscountType', 'subtitlesDiscountPercent', 'aiDiscounts'
                        ])) ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount', 'lastActiveAt', 'updatedAt']) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriberCount']) ||
                         ((!('subscriberCount' in resource.data) || resource.data.subscriberCount == null) && request.resource.data.subscriberCount == 1) ||
                         request.resource.data.subscriberCount == resource.data.subscriberCount + 1 ||
                         request.resource.data.subscriberCount == resource.data.subscriberCount - 1 ||
                         request.resource.data.subscriberCount == resource.data.subscriberCount ||
                         (resource.data.subscriberCount <= 0 && request.resource.data.subscriberCount == 0)))
                     );
      
      // Allow owners or admins to delete their channels
      allow delete: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());

      // Superchats subcollection (financial ledger)
      match /superchats/{superchatId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false; // Only Cloud Functions can author superchat ledger entries
      }

      // Subscribers subcollection
      match /subscribers/{subscriberId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == subscriberId;
      }

      // Stats subcollection (detailed analytics, watch time, views history)
      match /stats/{docId} {
        allow read: if isAuthenticated();
        allow write: if false; // System only
      }

      // Daily Stats subcollection (for analytics dashboards)
      match /daily_stats/{docId} {
        allow read: if isAuthenticated();
        allow write: if false; // System only
      }

      // Demographics subcollection (age, gender, geography metrics)
      match /demographics/{docId} {
        allow read: if isAuthenticated();
        allow write: if false; // System / Cloud Functions only
      }

      match /moderators/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && 
                         get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid;
      }

      // Blocked Users subcollection
      match /blocked_users/{userId} {
        allow read: if isAuthenticated() && 
                         (request.auth.uid == userId ||
                          get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid);
        allow write: if isAuthenticated() && 
                          get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid;
      }

      // Distributed Counter Shards (20 shards for channel views, watch time & subscribers)
      match /shards/{shardId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                         request.resource.data.keys().hasOnly(['views', 'watchTimeSeconds', 'subscriberDelta', 'updatedAt']) &&
                         (!('views' in request.resource.data) || (request.resource.data.views is int && request.resource.data.views >= 0 && request.resource.data.views <= 1)) &&
                         (!('watchTimeSeconds' in request.resource.data) || (request.resource.data.watchTimeSeconds is int && request.resource.data.watchTimeSeconds >= 0 && request.resource.data.watchTimeSeconds <= 60)) &&
                         (!('subscriberDelta' in request.resource.data) || (request.resource.data.subscriberDelta is int && request.resource.data.subscriberDelta >= -1 && request.resource.data.subscriberDelta <= 1));
        allow update: if isAuthenticated() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'watchTimeSeconds', 'subscriberDelta', 'updatedAt']) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views']) ||
                          (request.resource.data.views is int &&
                           (!('views' in resource.data) ? (request.resource.data.views >= 0 && request.resource.data.views <= 1) : (request.resource.data.views >= resource.data.views && request.resource.data.views <= resource.data.views + 1)))) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['watchTimeSeconds']) ||
                          (request.resource.data.watchTimeSeconds is int &&
                           (!('watchTimeSeconds' in resource.data) ? (request.resource.data.watchTimeSeconds >= 0 && request.resource.data.watchTimeSeconds <= 60) : (request.resource.data.watchTimeSeconds >= resource.data.watchTimeSeconds && request.resource.data.watchTimeSeconds <= resource.data.watchTimeSeconds + 60)))) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriberDelta']) ||
                          (request.resource.data.subscriberDelta is int && request.resource.data.subscriberDelta >= -1 && request.resource.data.subscriberDelta <= 1));
      }

      // Videos subcollection (alternate path)
      match /videos/{videoId} {
        allow list: if true;
        allow get: if resource == null ||
                      (!('visibility' in resource.data) ||
                       resource.data.visibility == null ||
                       resource.data.visibility == 'public' ||
                       resource.data.visibility == 'Public' ||
                       resource.data.visibility == 'unlisted' ||
                       resource.data.visibility == 'Unlisted' ||
                       !(resource.data.visibility in ['Private', 'private', 'draft', 'private_draft'])) ||
                      (isAuthenticated() && (
                        isAdmin() ||
                        isVideoDataOwner(resource.data) ||
                        request.auth.uid == channelId ||
                        (exists(/databases/$(database)/documents/channels/$(channelId)) &&
                         (('ownerId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
                           get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid) ||
                          ('userId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
                           get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)))
                      ));
        allow create: if isAuthenticated() && (
          isAdmin() ||
          ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
          ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
          ('uploaderId' in request.resource.data && request.resource.data.uploaderId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           (('ownerId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
             get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid) ||
            ('userId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
             get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)))
        );
        allow update: if isAuthenticated() && (
          isAdmin() ||
          ((isVideoDataOwner(resource.data) ||
            (exists(/databases/$(database)/documents/channels/$(channelId)) &&
             (('ownerId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
               get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid) ||
              ('userId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
               get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)))) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'userId', 'uploaderId']))
        );
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          isVideoDataOwner(resource.data) ||
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           (('ownerId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
             get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid) ||
            ('userId' in get(/databases/$(database)/documents/channels/$(channelId)).data &&
             get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)))
        );
      }

      // Membership Tiers subcollection
      match /membership_tiers/{tierId} {
        allow read: if true;
        allow write: if isAuthenticated() && (
          request.auth.uid == channelId ||
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)) ||
          isAdmin() ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt']) &&
           (request.resource.data.memberCount == resource.data.memberCount + 1 ||
            request.resource.data.memberCount == resource.data.memberCount - 1 ||
            request.resource.data.memberCount == resource.data.memberCount))
        );
      }

      // Channel Members subcollection (Authoritative writes from payment gateway Cloud Functions only)
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == channelId ||
          request.auth.uid == memberId ||
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isAdmin();
      }

      // Payout Settings Subcollection (Bank Account & Transfer Details)
      match /payout_settings/{settingId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == channelId ||
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)) ||
          isAdmin()
        );
      }

      // Creator KYC Verification Subcollection (Protected against client self-verification)
      match /kyc/{docId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == channelId ||
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)) ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.auth.uid == channelId ||
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)) ||
          isAdmin()
        ) &&
        (!('kycStatus' in request.resource.data) || request.resource.data.kycStatus == 'pending') &&
        (!('isNameMatched' in request.resource.data) || request.resource.data.isNameMatched == false);

        allow update: if isAuthenticated() && (
          isAdmin() ||
          (((request.auth.uid == channelId ||
             (exists(/databases/$(database)/documents/channels/$(channelId)) &&
              (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
               get(/databases/$(database)/documents/channels/$(channelId)).data.userId == request.auth.uid)))) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'kycStatus', 'isNameMatched', 'nameMatchScore', 'reviewedAt', 'reviewedBy'
            ]))
        );
        allow delete: if isAdmin();
      }

      // Donations / Super Thanks subcollection
      match /donations/{donationId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid ||
          resource.data.donorId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.donorId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }
    
    // Image Status Collection (for moderation)
    match /image_status/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Image Verification Collection
    match /image_verification/{verificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Videos Collection
    match /videos/{videoId} {
      allow list: if true;
      allow get: if resource == null ||
                    (!('visibility' in resource.data) ||
                     resource.data.visibility == null ||
                     resource.data.visibility == 'public' ||
                     resource.data.visibility == 'Public' ||
                     resource.data.visibility == 'unlisted' ||
                     resource.data.visibility == 'Unlisted' ||
                     !(resource.data.visibility in ['Private', 'private', 'draft', 'private_draft'])) ||
                    (isAuthenticated() && (
                      isAdmin() ||
                      isVideoDataOwner(resource.data)
                    ));
      
      // Allow authenticated users to create videos — all identity fields must match creator and metrics initialized to 0/empty
      allow create: if isAuthenticated() && 
                       (!('uploaderId' in request.resource.data) || request.resource.data.uploaderId == request.auth.uid) &&
                       (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
                       (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
                       (request.resource.data.uploaderId == request.auth.uid ||
                        request.resource.data.userId == request.auth.uid ||
                        request.resource.data.ownerId == request.auth.uid ||
                        isAdmin()) &&
                       !('credibilityScore' in request.resource.data) &&
                       !('truthScore' in request.resource.data) &&
                       !('gatewayDecision' in request.resource.data) &&
                       (!('pipelineStatus' in request.resource.data) || request.resource.data.pipelineStatus == 'pending' || request.resource.data.pipelineStatus == 'uploading') &&
                       (!('credibilityVerified' in request.resource.data) || request.resource.data.credibilityVerified == false) &&
                       (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
                       (!('factCheck' in request.resource.data) || request.resource.data.factCheck == null) &&
                       (!('views' in request.resource.data) || request.resource.data.views == 0) &&
                       (!('viewCount' in request.resource.data) || request.resource.data.viewCount == 0) &&
                       (!('playCount' in request.resource.data) || request.resource.data.playCount == 0) &&
                       (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0) &&
                       (!('dislikeCount' in request.resource.data) || request.resource.data.dislikeCount == 0) &&
                       (!('shareCount' in request.resource.data) || request.resource.data.shareCount == 0) &&
                       (!('commentCount' in request.resource.data) || request.resource.data.commentCount == 0) &&
                       (!('commentsCount' in request.resource.data) || request.resource.data.commentsCount == 0) &&
                       (!('languageRequestsCount' in request.resource.data) || request.resource.data.languageRequestsCount == 0) &&
                       (!('totalWatchTimeSeconds' in request.resource.data) || request.resource.data.totalWatchTimeSeconds == 0) &&
                       (!('engagement' in request.resource.data) || request.resource.data.engagement == 0 || request.resource.data.engagement == {}) &&
                       (!('likes' in request.resource.data) || request.resource.data.likes == 0 || request.resource.data.likes == [] || request.resource.data.likes == {}) &&
                       (!('dislikes' in request.resource.data) || request.resource.data.dislikes == 0 || request.resource.data.dislikes == [] || request.resource.data.dislikes == {});
      
      // Allow owners or admins to update their videos, or authenticated users to update engagement / interaction counts with bounded deltas
      allow update: if isAuthenticated() && (
        isAdmin() ||
        ((isVideoDataOwner(resource.data) || isVideoOwner(videoId)) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'ownerId', 'userId', 'channelId', 'uploaderId',
           'credibilityScore', 'factCheck', 'truthScore', 'pipelineStatus', 'moderation', 'moderationReason', 'gatewayDecision',
           'views', 'viewCount', 'playCount', 'credibilityVerified', 'isVerified',
           'credibility', 'credibilityStatus', 'factCheckDispute', 'claimLedger', 'factCheckStats', 'uiReport', 'isFactChecked', 'scoringFactors'
         ])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likeCount', 'dislikeCount', 'likes', 'dislikes', 'views', 'viewCount', 'shareCount', 'playCount', 'engagement', 'languageRequestsCount', 'commentCount', 'commentsCount', 'totalWatchTimeSeconds', 'updatedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likeCount']) ||
         (!('likeCount' in resource.data) && (request.resource.data.likeCount == 0 || request.resource.data.likeCount == 1)) ||
         ('likeCount' in resource.data && (
           request.resource.data.likeCount == resource.data.likeCount + 1 ||
           request.resource.data.likeCount == resource.data.likeCount - 1 ||
           request.resource.data.likeCount == resource.data.likeCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dislikeCount']) ||
         (!('dislikeCount' in resource.data) && (request.resource.data.dislikeCount == 0 || request.resource.data.dislikeCount == 1)) ||
         ('dislikeCount' in resource.data && (
           request.resource.data.dislikeCount == resource.data.dislikeCount + 1 ||
           request.resource.data.dislikeCount == resource.data.dislikeCount - 1 ||
           request.resource.data.dislikeCount == resource.data.dislikeCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount']) ||
         (!('viewCount' in resource.data) && request.resource.data.viewCount == 1) ||
         ('viewCount' in resource.data && (
           request.resource.data.viewCount == resource.data.viewCount + 1 ||
           request.resource.data.viewCount == resource.data.viewCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views']) ||
         (!('views' in resource.data) && request.resource.data.views == 1) ||
         ('views' in resource.data && (
           request.resource.data.views == resource.data.views + 1 ||
           request.resource.data.views == resource.data.views
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shareCount']) ||
         (!('shareCount' in resource.data) && (request.resource.data.shareCount == 0 || request.resource.data.shareCount == 1)) ||
         ('shareCount' in resource.data && (
           request.resource.data.shareCount == resource.data.shareCount + 1 ||
           request.resource.data.shareCount == resource.data.shareCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['playCount']) ||
         (!('playCount' in resource.data) && (request.resource.data.playCount == 0 || request.resource.data.playCount == 1)) ||
         ('playCount' in resource.data && (
           request.resource.data.playCount == resource.data.playCount + 1 ||
           request.resource.data.playCount == resource.data.playCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) ||
         (!('commentCount' in resource.data) && (request.resource.data.commentCount == 0 || request.resource.data.commentCount == 1)) ||
         ('commentCount' in resource.data && (
           request.resource.data.commentCount == resource.data.commentCount + 1 ||
           request.resource.data.commentCount == resource.data.commentCount - 1 ||
           request.resource.data.commentCount == resource.data.commentCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentsCount']) ||
         (!('commentsCount' in resource.data) && (request.resource.data.commentsCount == 0 || request.resource.data.commentsCount == 1)) ||
         ('commentsCount' in resource.data && (
           request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
           request.resource.data.commentsCount == resource.data.commentsCount - 1 ||
           request.resource.data.commentsCount == resource.data.commentsCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['languageRequestsCount']) ||
         (!('languageRequestsCount' in resource.data) && (request.resource.data.languageRequestsCount == 0 || request.resource.data.languageRequestsCount == 1)) ||
         ('languageRequestsCount' in resource.data && (
           request.resource.data.languageRequestsCount == resource.data.languageRequestsCount + 1 ||
           request.resource.data.languageRequestsCount == resource.data.languageRequestsCount - 1 ||
           request.resource.data.languageRequestsCount == resource.data.languageRequestsCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['engagement']) ||
         (!('engagement' in resource.data) && (request.resource.data.engagement == 0 || request.resource.data.engagement == 1 || request.resource.data.engagement is map)) ||
         ('engagement' in resource.data && (
           request.resource.data.engagement == resource.data.engagement + 1 ||
           request.resource.data.engagement == resource.data.engagement - 1 ||
           request.resource.data.engagement == resource.data.engagement ||
           request.resource.data.engagement is map
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalWatchTimeSeconds']) ||
         (!('totalWatchTimeSeconds' in resource.data) && (request.resource.data.totalWatchTimeSeconds >= 0 && request.resource.data.totalWatchTimeSeconds <= 60)) ||
         ('totalWatchTimeSeconds' in resource.data && (
           request.resource.data.totalWatchTimeSeconds >= resource.data.totalWatchTimeSeconds &&
           request.resource.data.totalWatchTimeSeconds <= resource.data.totalWatchTimeSeconds + 60
         ))))
      );
      
      // Allow owners to delete their videos
      allow delete: if isAuthenticated() && (isAdmin() || isVideoDataOwner(resource.data) || isVideoOwner(videoId));

      // Media subcollection (localization, credibility, streaming)
      match /media/{docId} {
        allow read: if true;
        allow write: if isVideoOwner(videoId);
      }

      // Subtitles, Chapters, Audio Tracks & Citations subcollections
      match /subtitles/{subtitleId} {
        allow read: if true;
        allow write: if isVideoOwner(videoId);
      }

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isVideoOwner(videoId);
      }

      match /audio_tracks/{trackId} {
        allow read: if true;
        allow write: if isVideoOwner(videoId);
      }

      match /citations/{citationId} {
        allow read: if true;
        allow write: if isVideoOwner(videoId);
      }

      // Language requests subcollection (viewers request dubbed audio/subtitles)
      match /language_requests/{requestId} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
          ('requesters' in request.resource.data && request.resource.data.requesters.hasAll([request.auth.uid])) ||
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          isAdmin() ||
          isVideoOwner(videoId) ||
          ('userId' in resource.data && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
          ('requesters' in request.resource.data && request.resource.data.requesters.hasAll([request.auth.uid]))
        );
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          isVideoOwner(videoId) ||
          ('userId' in resource.data && resource.data.userId == request.auth.uid)
        );
      }

      // View tracking subcollection (one doc per user per video)
      match /views/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Distributed Counter Shards (20 shards for viral video views & watch time)
      match /shards/{shardId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                         request.resource.data.keys().hasOnly(['count', 'qualifiedCount', 'watchTimeSeconds', 'updatedAt']) &&
                         (!('count' in request.resource.data) || (request.resource.data.count is int && request.resource.data.count >= 0 && request.resource.data.count <= 1)) &&
                         (!('qualifiedCount' in request.resource.data) || (request.resource.data.qualifiedCount is int && request.resource.data.qualifiedCount >= 0 && request.resource.data.qualifiedCount <= 1)) &&
                         (!('watchTimeSeconds' in request.resource.data) || (request.resource.data.watchTimeSeconds is int && request.resource.data.watchTimeSeconds >= 0 && request.resource.data.watchTimeSeconds <= 60));
        allow update: if isAuthenticated() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'qualifiedCount', 'watchTimeSeconds', 'updatedAt']) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['count']) ||
                          (request.resource.data.count is int &&
                           (!('count' in resource.data) ? (request.resource.data.count >= 0 && request.resource.data.count <= 1) : (request.resource.data.count >= resource.data.count && request.resource.data.count <= resource.data.count + 1)))) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['qualifiedCount']) ||
                          (request.resource.data.qualifiedCount is int &&
                           (!('qualifiedCount' in resource.data) ? (request.resource.data.qualifiedCount >= 0 && request.resource.data.qualifiedCount <= 1) : (request.resource.data.qualifiedCount >= resource.data.qualifiedCount && request.resource.data.qualifiedCount <= resource.data.qualifiedCount + 1)))) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['watchTimeSeconds']) ||
                          (request.resource.data.watchTimeSeconds is int &&
                           (!('watchTimeSeconds' in resource.data) ? (request.resource.data.watchTimeSeconds >= 0 && request.resource.data.watchTimeSeconds <= 60) : (request.resource.data.watchTimeSeconds >= resource.data.watchTimeSeconds && request.resource.data.watchTimeSeconds <= resource.data.watchTimeSeconds + 60))));
      }

      // Distributed Counter Shards (20 shards for viral video comments)
      match /comment_shards/{shardId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.keys().hasOnly(['commentCount', 'updatedAt']);
        allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']);
      }

      // Likes/Dislikes subcollections
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /dislikes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                         (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
        allow update: if isAuthenticated() && (
          isVideoOwner(videoId) ||
          isAdmin() ||
          (resource.data.userId == request.auth.uid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isHeartedByCreator', 'creatorHeartName'])) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likeCount', 'dislikeCount', 'likes', 'dislikes', 'replyCount'
          ])
        );
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isVideoOwner(videoId)
        );

        // Replies subcollection
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                           (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
          allow update: if isAuthenticated() && (
            isVideoOwner(videoId) ||
            isAdmin() ||
            (resource.data.userId == request.auth.uid &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isHeartedByCreator', 'creatorHeartName'])) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likeCount', 'dislikeCount', 'likes', 'dislikes'
            ])
          );
          allow delete: if isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            isVideoOwner(videoId)
          );

          match /likes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }

          match /dislikes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }
        }

        match /likes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      // Claim Comments subcollection (Community Deliberation Notes)
      match /claim_comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                         (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isVideoOwner(videoId) ||
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'helpfulCount', 'unhelpfulCount', 'helpfulUserIds', 'unhelpfulUserIds',
            'likes', 'dislikes', 'likeCount', 'dislikeCount'
          ])
        );
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isVideoOwner(videoId) ||
          isAdmin()
        );
      }
    }
    
    // Topics Collection
    match /topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        // Enforce identity: creatorId must match the authenticated user
        (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid) &&
        (((request.resource.data.videoCount is number && request.resource.data.videoCount > 0) ||
          (request.resource.data.featuredVideoIds is list && request.resource.data.featuredVideoIds.size() > 0)) &&
         (!('geminiApproved' in request.resource.data) || request.resource.data.geminiApproved == false) &&
         (!('status' in request.resource.data) || request.resource.data.status == 'pending' || request.resource.data.status == 'underReview')) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        ((resource.data.creatorId == request.auth.uid ||
          (resource.data.channelId != null &&
           exists(/databases/$(database)/documents/channels/$(resource.data.channelId)) &&
           get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerId == request.auth.uid)) &&
         (
           // Soft-delete by topic creator or channel owner
           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'visibilityType', 'deletionRequestedAt']) &&
            request.resource.data.status == 'deletion_pending') ||
           // General topic edits by topic creator or channel owner
           (
             // Prevent changing creatorId
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorId']) &&
             // Prevent modifying moderatedAt
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderatedAt']) &&
             // videoCount must be a number >= 0 if updated
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['videoCount']) ||
              (request.resource.data.videoCount is number && request.resource.data.videoCount >= 0)) &&
             // status: unchanged, or set to 'pending' or 'underReview' (non-admins cannot set 'active')
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              request.resource.data.status == 'pending' ||
              request.resource.data.status == 'underReview') &&
             // moderationReason: unchanged, deleted, or cleared (null or empty string)
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationReason']) ||
              !('moderationReason' in request.resource.data) ||
              request.resource.data.moderationReason == null ||
              request.resource.data.moderationReason == '') &&
             // geminiApproved: unchanged, deleted, or false (non-admins cannot set to true)
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['geminiApproved']) ||
              !('geminiApproved' in request.resource.data) ||
              request.resource.data.geminiApproved == false)
           )
         )) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likeCount', 'dislikes', 'followers', 'followerCount', 'commentCount'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) ||
         (!('likes' in resource.data) && (request.resource.data.likes == 1 || request.resource.data.likes == 0)) ||
         ('likes' in resource.data && (
           request.resource.data.likes == resource.data.likes + 1 ||
           request.resource.data.likes == resource.data.likes - 1 ||
           request.resource.data.likes == resource.data.likes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likeCount']) ||
         (!('likeCount' in resource.data) && (request.resource.data.likeCount == 1 || request.resource.data.likeCount == 0)) ||
         ('likeCount' in resource.data && (
           request.resource.data.likeCount == resource.data.likeCount + 1 ||
           request.resource.data.likeCount == resource.data.likeCount - 1 ||
           request.resource.data.likeCount == resource.data.likeCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dislikes']) ||
         (!('dislikes' in resource.data) && (request.resource.data.dislikes == 1 || request.resource.data.dislikes == 0)) ||
         ('dislikes' in resource.data && (
           request.resource.data.dislikes == resource.data.dislikes + 1 ||
           request.resource.data.dislikes == resource.data.dislikes - 1 ||
           request.resource.data.dislikes == resource.data.dislikes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['followers']) ||
         (!('followers' in resource.data) && (request.resource.data.followers == 1 || request.resource.data.followers == 0)) ||
         ('followers' in resource.data && (
           request.resource.data.followers == resource.data.followers + 1 ||
           request.resource.data.followers == resource.data.followers - 1 ||
           request.resource.data.followers == resource.data.followers
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['followerCount']) ||
         (!('followerCount' in resource.data) && (request.resource.data.followerCount == 1 || request.resource.data.followerCount == 0)) ||
         ('followerCount' in resource.data && (
           request.resource.data.followerCount == resource.data.followerCount + 1 ||
           request.resource.data.followerCount == resource.data.followerCount - 1 ||
           request.resource.data.followerCount == resource.data.followerCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) ||
         (!('commentCount' in resource.data) && (request.resource.data.commentCount == 1 || request.resource.data.commentCount == 0)) ||
         ('commentCount' in resource.data && (
           request.resource.data.commentCount == resource.data.commentCount + 1 ||
           request.resource.data.commentCount == resource.data.commentCount - 1 ||
           request.resource.data.commentCount == resource.data.commentCount
         ))))
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.creatorId == request.auth.uid ||
        (resource.data.channelId != null &&
         exists(/databases/$(database)/documents/channels/$(resource.data.channelId)) &&
         get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerId == request.auth.uid)
      );

      // Likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Followers subcollection
      match /followers/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Distributed Counter Shards (20 shards for topic comments)
      match /shards/{shardId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.keys().hasOnly(['commentCount', 'updatedAt']);
        allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'updatedAt']);
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                         (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
        );
        allow delete: if isAuthenticated() && 
                         (resource.data.userId == request.auth.uid || 
                          resource.data.channelId == request.auth.uid ||
                          isAdmin());

        match /likes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        // Replies subcollection
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                           (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
          allow update: if isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            isAdmin() ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
          );
          allow delete: if isAuthenticated() && 
                           (resource.data.userId == request.auth.uid || 
                            resource.data.channelId == request.auth.uid ||
                            isAdmin());

          match /likes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }

          match /dislikes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }
        }
      }
    }

    // Legacy Topic Likes Collection
    match /topic_likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Legacy Topic Followers Collection
    match /topic_followers/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Topic Reports Collection
    match /topic_reports/{reportId} {
      allow read: if false; // Admin only
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // Video Transcripts Subcollection (legacy — backend write only)
    match /videos/{videoId}/transcripts/{transcriptId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend service account can write
    }

    // Progressive Claim Streaming Subcollection (fact checking pipeline — publicly readable, backend write only)
    match /videos/{videoId}/claims/{claimId} {
      allow read: if true;
      allow write: if false; // Strictly server-only; only Firebase Admin SDK / Cloud Functions pipeline writes claim documents
    }

    // Video Transcripts Collection (Root level - pipeline generated, readable by authenticated users)
    match /transcripts/{transcriptId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend service account can write
    }

    // Pipeline Errors Collection (backend monitoring)
    match /pipeline_errors/{errorId} {
      allow read: if false; // Admin console only
      allow write: if false; // Only backend can write
    }

    // Subscriptions Collection (Legacy/Frontend)
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Subcollection for user-specific subscription lists (/subscriptions/{userId}/list/{docId})
      match /list/{docId} {
        allow read, write: if isAuthenticated() && subscriptionId == request.auth.uid;
      }
    }

    // User Cache Collection
    match /userCache/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Search Cache Collection (backend-only distributed cache for searchTruthWorld)
    // Only the Cloud Function Admin SDK can read/write this collection.
    // Client access is denied entirely to prevent cache poisoning and quota abuse.
    match /search_cache/{docId} {
      allow read, write: if false;
    }

    // Channel Subscribers Collection (Cloud Functions / New Schema)
    match /channel_subscribers/{subId} {
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || 
                      resource.data.channelId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownedChannels);
      allow write: if false; // Only Cloud Functions should write here
    }
    
    // Users Collection
    match /users/{userId} {
      // Restrict read to authenticated user or admin to protect PII
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Allow users to create their own profile without administrative privileges, or admins to create/initialize user profiles
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId &&
         (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
         (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
         (!('isSuperadmin' in request.resource.data) || request.resource.data.isSuperadmin == false) &&
         (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
         (!('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0) &&
         (!('walletBalanceUSD' in request.resource.data) || request.resource.data.walletBalanceUSD == 0) &&
         (!('hasChannel' in request.resource.data) || request.resource.data.hasChannel == false) &&
         (!('channelId' in request.resource.data) || request.resource.data.channelId == null) &&
         (!('monetizationTier' in request.resource.data) || request.resource.data.monetizationTier == 'free') &&
         (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false) &&
         (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
         (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'ACTIVE' || request.resource.data.accountStatus == 'active') &&
         (!('strikes' in request.resource.data) || request.resource.data.strikes == 0)) ||
        isAdmin()
      );
      
      // Allow users to update their own profile but disallow self-assigning admin, permission roles, premium, or financial balances
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 'isAdmin', 'isSuperadmin', 'permissions', 'isPremium', 'monetizationTier',
           'premiumExpiresAt', 'premiumPlanId', 'walletBalance', 'walletBalanceUSD',
           'hasChannel', 'channelId', 'channelsCount',
           'isBanned', 'bannedAt', 'banReason', 'accountStatus', 'status', 'strikes', 'trustScore'
         ])) ||
        isAdmin()
      );
      
      // Allow user owners or admins to delete user profiles
      allow delete: if isOwner(userId) || isAdmin();

      // User Playlists subcollection
      match /playlists/{playlistId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;

        match /items/{videoId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      match /saved_playlists/{playlistId} {
        allow read, write: if isOwner(userId);
      }

      // User Clips subcollection
      match /clips/{clipId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Videos subcollection
      match /likedVideos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      match /liked_videos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Disliked Videos subcollection
      match /dislikedVideos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      match /disliked_videos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Watch Later subcollection
      match /watch_later/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Watch History subcollection
      match /watch_history/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Feed Inbox subcollection (Materialized Fan-Out Feeds)
      match /feed_inbox/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Topics subcollection
      match /likedTopics/{topicId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Topics subcollection
      match /savedTopics/{topicId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Topic Comments subcollection
      match /liked_topic_comments/{commentId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Topic Replies subcollection
      match /liked_topic_replies/{replyId} {
        allow read, write: if isOwner(userId);
      }

      // User Video Comment Interactions subcollection
      match /comment_interactions/{commentId} {
        allow read, write: if isOwner(userId);
      }

      // User Video Reply Interactions subcollection
      match /reply_interactions/{replyId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Clips subcollection
      match /liked_clips/{clipId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Community Posts subcollection
      match /savedCommunityPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Comments subcollection
      match /savedComments/{commentId} {
        allow read, write: if isOwner(userId);
      }

      // User Hidden Community Posts subcollection
      match /hiddenCommunityPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // User Muted Community Channels subcollection
      match /mutedCommunityChannels/{channelId} {
        allow read, write: if isOwner(userId);
      }

      // User Reported Community Posts subcollection
      match /reportedCommunityPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // User Subscriptions subcollection
      match /subscriptions/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }

      // User Channel Memberships subcollection (/users/{userId}/channelMemberships/{channelId})
      match /channelMemberships/{channelId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /channel_memberships/{channelId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // User Active Notifications subcollection
      match /notifications_active/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // User Archived Notifications subcollection
      match /notifications_archive/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Ads subcollection
      match /saved_ads/{adId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Videos subcollection
      match /saved_videos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Bookmarked Community Posts subcollection
      match /bookmarks/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User In-App Notifications subcollection
      match /notifications/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Payout Settings subcollection (e.g., creator bank account fallback)
      match /payout_settings/{settingId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // User Notifications Collection
    match /user_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.channelId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        ((!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
         (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid) &&
         (request.resource.data.userId == request.auth.uid ||
          request.resource.data.creatorId == request.auth.uid ||
          request.resource.data.channelId == request.auth.uid))
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.channelId == request.auth.uid ||
        isAdmin()
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'creatorId']));
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.channelId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // Ad Campaigns Collection
    match /ad_campaigns/{campaignId} {
      allow read: if resource.data.status == 'active' || (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid &&
         (!('status' in request.resource.data) || request.resource.data.status == 'draft' || request.resource.data.status == 'pendingPayment' || request.resource.data.status == 'underReview') &&
         (!('spentAmount' in request.resource.data) || request.resource.data.spentAmount == 0) &&
         (!('isPaid' in request.resource.data) || request.resource.data.isPaid == false) &&
         (!('paidAmount' in request.resource.data) || request.resource.data.paidAmount == 0) &&
         (!('impressions' in request.resource.data) || request.resource.data.impressions == 0) &&
         (!('clicks' in request.resource.data) || request.resource.data.clicks == 0)) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'status', 'budgetAmount', 'spentAmount', 'isPaid', 'paidAmount', 'orderId', 'impressions', 'clicks'
         ]))
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Metrics subcollection
      match /metrics/{metricId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/ad_campaigns/$(campaignId)).data.userId == request.auth.uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Ad Likes Collection
    match /ad_likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Ad Saves Collection
    match /ad_saves/{saveId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Ad Comments Collection
    match /ad_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Ad Reports Collection
    match /ad_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Advertiser Profiles Collection
    match /advertiser_profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId &&
         (!('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0) &&
         (!('isBrandVerified' in request.resource.data) || request.resource.data.isBrandVerified == false)) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'isBrandVerified']))
      );
      allow delete: if isAdmin();

      // Financial Transactions subcollection (Cloud Functions / Admin SDK only writes)
      match /transactions/{transactionId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }

      // Billing Transactions subcollection (Cloud Functions / Admin SDK only writes)
      match /billing_transactions/{txId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }

      // Audience Targeting Presets subcollection
      match /audience_presets/{presetId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }

      // Creator Sponsorship Proposals subcollection
      match /sponsorship_proposals/{proposalId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          resource.data.creatorId == request.auth.uid ||
          isAdmin()
        );
        allow write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }

      // Creative Assets subcollection
      match /creative_assets/{assetId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }

    }
    
    // Comments Collection
    match /comments/{commentId} {
      // Allow anyone to read comments
      allow read: if true;
      
      // Allow authenticated users to create comments
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
      
      // Allow comment owners to update/delete
      allow update, delete: if isAuthenticated() && 
                               resource.data.userId == request.auth.uid;
    }
    
    // Likes Collection
    match /likes/{likeId} {
      // Allow anyone to read likes
      allow read: if true;
      
      // Allow authenticated users to create/delete their own likes
      allow create, delete: if isAuthenticated() && 
                               request.resource.data.userId == request.auth.uid;
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      // Allow users to read their own notifications
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Allow system/backend to create notifications
      allow create: if isAdmin();
      
      // Allow users to update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Allow users to delete their own notifications
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Playlists Collection
    match /playlists/{playlistId} {
      // Allow reading playlists across public, channel, and studio views
      allow read: if true;
      
      // Allow authenticated users to create playlists — all identity fields must match the creator
      allow create: if isAuthenticated() && 
                       (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
                       (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
                       (request.resource.data.ownerId == request.auth.uid ||
                        request.resource.data.userId == request.auth.uid ||
                        isAdmin());
      
      // Allow owners or channel managers to update/delete their playlists
      allow update, delete: if isAuthenticated() && 
                               (resource.data.ownerId == request.auth.uid ||
                                resource.data.userId == request.auth.uid ||
                                (resource.data.channelId != null &&
                                 exists(/databases/$(database)/documents/channels/$(resource.data.channelId)) &&
                                 get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerId == request.auth.uid) ||
                                isAdmin());
    }
    
    // Community Collection
    match /Community/{postId} {
      // Allow anyone to read community posts
      allow read: if true;
      
      // Allow authenticated users to create community posts
      allow create: if isAuthenticated() && 
                       (request.resource.data.ownerId == request.auth.uid ||
                        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
                        isAdmin());
      
      // Allow owners to update/delete, or other users to update interaction fields
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isCommunityPostOwner(postId) ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy', 'likedby', 'dislikes', 'dislikedBy', 'dislikedby', 'commentCount', 'poll', 'shares'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) ||
         (!('likes' in resource.data) && (request.resource.data.likes == 0 || request.resource.data.likes == 1)) ||
         ('likes' in resource.data && (
           request.resource.data.likes == resource.data.likes + 1 ||
           request.resource.data.likes == resource.data.likes - 1 ||
           request.resource.data.likes == resource.data.likes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dislikes']) ||
         (!('dislikes' in resource.data) && (request.resource.data.dislikes == 0 || request.resource.data.dislikes == 1)) ||
         ('dislikes' in resource.data && (
           request.resource.data.dislikes == resource.data.dislikes + 1 ||
           request.resource.data.dislikes == resource.data.dislikes - 1 ||
           request.resource.data.dislikes == resource.data.dislikes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) ||
         (!('commentCount' in resource.data) && (request.resource.data.commentCount == 0 || request.resource.data.commentCount == 1)) ||
         ('commentCount' in resource.data && (
           request.resource.data.commentCount == resource.data.commentCount + 1 ||
           request.resource.data.commentCount == resource.data.commentCount - 1 ||
           request.resource.data.commentCount == resource.data.commentCount
         ))))
      );
                     
      allow delete: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid ||
                        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
                        isCommunityPostOwner(postId) ||
                        isAdmin());

      // Likes/Dislikes subcollections on post
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /dislikes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.channelId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          isCommunityPostOwner(postId) ||
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likeCount', 'dislikeCount', 'likes', 'dislikes', 'likedBy', 'likedby', 'dislikedBy', 'dislikedby', 'replyCount'
          ])
        );
        allow delete: if isAuthenticated() && 
                         (resource.data.userId == request.auth.uid || 
                          resource.data.channelId == request.auth.uid ||
                          resource.data.ownerId == request.auth.uid ||
                          isCommunityPostOwner(postId) ||
                          isAdmin());

        // Replies subcollection
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update: if isAuthenticated() && (
            resource.data.userId == request.auth.uid || 
            resource.data.channelId == request.auth.uid ||
            resource.data.ownerId == request.auth.uid ||
            isCommunityPostOwner(postId) ||
            isAdmin() ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likeCount', 'dislikeCount', 'likes', 'dislikes', 'likedBy', 'likedby', 'dislikedBy', 'dislikedby'
            ])
          );
          allow delete: if isAuthenticated() && 
                           (resource.data.userId == request.auth.uid || 
                            resource.data.channelId == request.auth.uid ||
                            resource.data.ownerId == request.auth.uid ||
                            isCommunityPostOwner(postId) ||
                            isAdmin());

          match /likes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }

          match /dislikes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }
        }

        match /likes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    match /community/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                       (request.resource.data.ownerId == request.auth.uid ||
                        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
                        isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isCommunityPostOwner(postId) ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy', 'likedby', 'dislikes', 'dislikedBy', 'dislikedby', 'commentCount', 'poll', 'shares'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) ||
         (!('likes' in resource.data) && (request.resource.data.likes == 0 || request.resource.data.likes == 1)) ||
         ('likes' in resource.data && (
           request.resource.data.likes == resource.data.likes + 1 ||
           request.resource.data.likes == resource.data.likes - 1 ||
           request.resource.data.likes == resource.data.likes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dislikes']) ||
         (!('dislikes' in resource.data) && (request.resource.data.dislikes == 0 || request.resource.data.dislikes == 1)) ||
         ('dislikes' in resource.data && (
           request.resource.data.dislikes == resource.data.dislikes + 1 ||
           request.resource.data.dislikes == resource.data.dislikes - 1 ||
           request.resource.data.dislikes == resource.data.dislikes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) ||
         (!('commentCount' in resource.data) && (request.resource.data.commentCount == 0 || request.resource.data.commentCount == 1)) ||
         ('commentCount' in resource.data && (
           request.resource.data.commentCount == resource.data.commentCount + 1 ||
           request.resource.data.commentCount == resource.data.commentCount - 1 ||
           request.resource.data.commentCount == resource.data.commentCount
         ))))
      );
      allow delete: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid ||
                        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
                        isCommunityPostOwner(postId) ||
                        isAdmin());
      
      // Likes/Dislikes subcollections on post
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /dislikes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.channelId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          isCommunityPostOwner(postId) ||
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likeCount', 'dislikeCount', 'likes', 'dislikes', 'likedBy', 'likedby', 'dislikedBy', 'dislikedby', 'replyCount'
          ])
        );
        allow delete: if isAuthenticated() && 
                         (resource.data.userId == request.auth.uid || 
                          resource.data.channelId == request.auth.uid ||
                          resource.data.ownerId == request.auth.uid ||
                          isCommunityPostOwner(postId) ||
                          isAdmin());

        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update: if isAuthenticated() && (
            resource.data.userId == request.auth.uid || 
            resource.data.channelId == request.auth.uid ||
            resource.data.ownerId == request.auth.uid ||
            isCommunityPostOwner(postId) ||
            isAdmin() ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likeCount', 'dislikeCount', 'likes', 'dislikes', 'likedBy', 'likedby', 'dislikedBy', 'dislikedby'
            ])
          );
          allow delete: if isAuthenticated() && 
                           (resource.data.userId == request.auth.uid || 
                            resource.data.channelId == request.auth.uid ||
                            resource.data.ownerId == request.auth.uid ||
                            isCommunityPostOwner(postId) ||
                            isAdmin());

          match /likes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }

          match /dislikes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }
        }

        match /likes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                       (request.resource.data.ownerId == request.auth.uid ||
                        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
                        isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isCommunityPostOwner(postId) ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy', 'likedby', 'dislikes', 'dislikedBy', 'dislikedby', 'commentCount', 'poll', 'shares'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes']) ||
         (!('likes' in resource.data) && (request.resource.data.likes == 0 || request.resource.data.likes == 1)) ||
         ('likes' in resource.data && (
           request.resource.data.likes == resource.data.likes + 1 ||
           request.resource.data.likes == resource.data.likes - 1 ||
           request.resource.data.likes == resource.data.likes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dislikes']) ||
         (!('dislikes' in resource.data) && (request.resource.data.dislikes == 0 || request.resource.data.dislikes == 1)) ||
         ('dislikes' in resource.data && (
           request.resource.data.dislikes == resource.data.dislikes + 1 ||
           request.resource.data.dislikes == resource.data.dislikes - 1 ||
           request.resource.data.dislikes == resource.data.dislikes
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) ||
         (!('commentCount' in resource.data) && (request.resource.data.commentCount == 0 || request.resource.data.commentCount == 1)) ||
         ('commentCount' in resource.data && (
           request.resource.data.commentCount == resource.data.commentCount + 1 ||
           request.resource.data.commentCount == resource.data.commentCount - 1 ||
           request.resource.data.commentCount == resource.data.commentCount
         ))))
      );
      allow delete: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid ||
                        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
                        isCommunityPostOwner(postId) ||
                        isAdmin());
      
      // Likes/Dislikes subcollections on post
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /dislikes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.channelId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          isCommunityPostOwner(postId) ||
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likeCount', 'dislikeCount', 'likes', 'dislikes', 'likedBy', 'likedby', 'dislikedBy', 'dislikedby', 'replyCount'
          ])
        );
        allow delete: if isAuthenticated() && 
                         (resource.data.userId == request.auth.uid || 
                          resource.data.channelId == request.auth.uid ||
                          resource.data.ownerId == request.auth.uid ||
                          isCommunityPostOwner(postId) ||
                          isAdmin());

        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update: if isAuthenticated() && (
            resource.data.userId == request.auth.uid || 
            resource.data.channelId == request.auth.uid ||
            resource.data.ownerId == request.auth.uid ||
            isCommunityPostOwner(postId) ||
            isAdmin() ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likeCount', 'dislikeCount', 'likes', 'dislikes', 'likedBy', 'likedby', 'dislikedBy', 'dislikedby'
            ])
          );
          allow delete: if isAuthenticated() && 
                           (resource.data.userId == request.auth.uid || 
                            resource.data.channelId == request.auth.uid ||
                            resource.data.ownerId == request.auth.uid ||
                            isCommunityPostOwner(postId) ||
                            isAdmin());

          match /likes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }

          match /dislikes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }
        }

        match /likes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    // Public Playlists Collection (alternate root)
    match /public_playlists/{playlistId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                       (request.resource.data.ownerId == request.auth.uid ||
                        request.resource.data.userId == request.auth.uid ||
                        isAdmin());
      allow update, delete: if isAuthenticated() && 
                               (resource.data.ownerId == request.auth.uid || isAdmin());

      match /items/{videoId} {
        allow read: if true;
        allow write: if isAuthenticated() && 
                         (get(/databases/$(database)/documents/public_playlists/$(playlistId)).data.ownerId == request.auth.uid ||
                          isAdmin());
      }
    }
    
    // Channel Slugs (managed strictly by Cloud Functions createChannel / cascadeDelete)
    match /channel_slugs/{slug} {
      allow read: if true;
      allow write: if false; // Slugs are managed exclusively by backend Cloud Functions
    }

    // Analytics and Stats
    match /video_stats/{videoId} {
      allow read: if true;
      allow write: if false; // System only
    }

    match /video_state_stats/{videoId} {
      allow read: if true;
      allow write: if false; // System only

      match /states/{stateId} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    // Watch History — per user per video (merge upsert)
    match /users/{userId}/watch_history/{videoId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Watch History Collection (legacy)
    match /watch_history/{historyId} {
      // Allow users to read their own watch history
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Allow users to create their own watch history
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Allow users to delete their own watch history
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Feeds Collection (for aggregated data like 'home')
    match /feeds/{feedId} {
      allow read: if true;
      allow write: if false; // Only backend or admin should write
    }

    // ================================================================
    // ANALYTICS COLLECTIONS (server-written, client-read)
    // ================================================================

    // Raw watch events (written by Cloud Function, read by aggregator)
    match /watch_events_raw/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Pre-aggregated daily video stats
    match /video_stats_daily/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Pre-aggregated daily channel stats
    match /channel_stats_daily/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Resolution jobs (transcoding status)
    match /resolution_jobs/{jobId} {
      allow read: if true;
      allow write: if false; // Backend only
    }

    // Live viewing sessions (written by Cloud Function)
    match /live_sessions/{videoId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only

      match /viewers/{viewerId} {
        allow read: if isAuthenticated();
        allow write: if false; // Cloud Function only
      }
    }

    // Pre-aggregated hourly video stats (real-time recent trends)
    match /video_stats_hourly/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Server-side view dedup: 1 qualified view per user per video per day
    // Document ID: `{videoId}_{userId}_{YYYY_MM_DD}`
    match /qualified_views/{dedupId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function creates via transaction
    }

    // Fraud flags — server-evaluated behavioral anomalies
    match /fraud_flags/{flagId} {
      allow read: if false; // Admin console only
      allow write: if false; // Cloud Function only
    }

    // Impression events — thumbnail visibility tracking for true CTR
    match /impressions_raw/{impressionId} {
      allow read: if false; // Aggregator only
      allow create: if isAuthenticated(); // Client batches impressions
      allow update, delete: if false;
    }

    // Idempotency keys — prevents duplicate Cloud Function event writes
    match /idempotency_keys/{keyId} {
      allow read: if false; // Cloud Function internal
      allow write: if false; // Cloud Function only
    }

    // Copyright Assets Collection
    match /copyright_assets/{assetId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Copyright Chunks Collection
    match /copyright_chunks/{chunkId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Copyright Matches Collection
    match /copyright_matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Copyright Claims Collection
    match /copyright_claims/{claimId} {
      allow read: if isAuthenticated() && (
        ('uploaderId' in resource.data && resource.data.uploaderId == request.auth.uid) ||
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('claimantId' in resource.data && resource.data.claimantId == request.auth.uid) ||
        ('channelId' in resource.data && (
          resource.data.channelId == request.auth.uid ||
          (exists(/databases/$(database)/documents/channels/$(resource.data.channelId)) &&
           (('ownerId' in get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data &&
             get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerId == request.auth.uid) ||
            ('userId' in get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data &&
             get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.userId == request.auth.uid)))
        )) ||
        ('ownerChannelId' in resource.data && (
          resource.data.ownerChannelId == request.auth.uid ||
          (exists(/databases/$(database)/documents/channels/$(resource.data.ownerChannelId)) &&
           (('ownerId' in get(/databases/$(database)/documents/channels/$(resource.data.ownerChannelId)).data &&
             get(/databases/$(database)/documents/channels/$(resource.data.ownerChannelId)).data.ownerId == request.auth.uid) ||
            ('userId' in get(/databases/$(database)/documents/channels/$(resource.data.ownerChannelId)).data &&
             get(/databases/$(database)/documents/channels/$(resource.data.ownerChannelId)).data.userId == request.auth.uid)))
        )) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        ('uploaderId' in request.resource.data && request.resource.data.uploaderId == request.auth.uid) ||
        ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
        ('claimantId' in request.resource.data && request.resource.data.claimantId == request.auth.uid) ||
        ('channelId' in request.resource.data && (
          request.resource.data.channelId == request.auth.uid ||
          (exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId)) &&
           (('ownerId' in get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data &&
             get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerId == request.auth.uid) ||
            ('userId' in get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data &&
             get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.userId == request.auth.uid)))
        )) ||
        ('ownerChannelId' in request.resource.data && (
          request.resource.data.ownerChannelId == request.auth.uid ||
          (exists(/databases/$(database)/documents/channels/$(request.resource.data.ownerChannelId)) &&
           (('ownerId' in get(/databases/$(database)/documents/channels/$(request.resource.data.ownerChannelId)).data &&
             get(/databases/$(database)/documents/channels/$(request.resource.data.ownerChannelId)).data.ownerId == request.auth.uid) ||
            ('userId' in get(/databases/$(database)/documents/channels/$(request.resource.data.ownerChannelId)).data &&
             get(/databases/$(database)/documents/channels/$(request.resource.data.ownerChannelId)).data.userId == request.auth.uid)))
        )) ||
        isAdmin()
      );
      allow update, delete: if false; // Only backend can update or delete claims
    }

    // Copyright Appeals Collection
    match /copyright_appeals/{appealId} {
      allow read: if isAuthenticated() && (
        ('appellantId' in resource.data && resource.data.appellantId == request.auth.uid) ||
        ('claimantId' in resource.data && resource.data.claimantId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        ('appellantId' in request.resource.data && request.resource.data.appellantId == request.auth.uid) ||
        ('claimantId' in request.resource.data && request.resource.data.claimantId == request.auth.uid) ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow update, delete: if false; // Only backend can update or delete appeals
    }

    // Channel Strikes
    match /channel_strikes/{strikeId} {
      allow read: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('channelId' in resource.data && (
          resource.data.channelId == request.auth.uid ||
          (exists(/databases/$(database)/documents/channels/$(resource.data.channelId)) &&
           (('ownerId' in get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data &&
             get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.ownerId == request.auth.uid) ||
            ('userId' in get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data &&
             get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.userId == request.auth.uid)))
        )) ||
        isAdmin()
      );
      allow write: if false; // Only backend can issue or modify strikes
    }

    // Copyright Owner Notifications
    match /copyright_owner_notifications/{notifId} {
      allow read: if isAuthenticated() && (
        ('originalOwnerId' in resource.data && resource.data.originalOwnerId == request.auth.uid) ||
        ('copiedUserId' in resource.data && resource.data.copiedUserId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if false; // Only backend writes notifications
    }

    // Content Verifications Collection
    match /content_verifications/{verificationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // AI Health state (Circuit Breaker)
    match /_ai_health/{document=**} {
      allow read, write: if false; // Only Cloud Functions service accounts can access
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.reportedBy == request.auth.uid ||
        request.resource.data.userEmail == request.auth.token.email
      );
    }

    match /video_reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() && 
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
        (!('reporterId' in request.resource.data) || request.resource.data.reporterId == request.auth.uid);
    }

    match /videoReports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() && 
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
        (!('reporterId' in request.resource.data) || request.resource.data.reporterId == request.auth.uid);
    }

    // Admin Settings & Moderation Modes
    match /admin_settings/{doc=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /system_settings/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Remote Config & Dynamic Algorithm Weights
    match /remote_config/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Configuration & Real-Time Service Controls
    match /system_config/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Automated Pipeline System Alerts
    match /system_alerts/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Claim Sources (Crowdsourced Fact-Check Submissions)
    match /claim_sources/{sourceId} {
      allow read: if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // AI Fact-Check Verification Requests
    match /fact_check_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.requestedBy == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.requestedBy == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      ) &&
      (!('status' in request.resource.data) || request.resource.data.status == 'queued' || request.resource.data.status == 'pending') &&
      request.resource.data.videoId is string;
      allow update, delete: if isAdmin();
    }

    // User Drafts Collection
    match /user_drafts/{draftId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notification Preferences Collection
    match /notification_preferences/{prefId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Watch Sessions Collection (Cloud Functions Admin SDK write-only)
    match /watch_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow write: if false; // Authoritative writes handled exclusively by watchtime Cloud Function
    }

    // Analytics Collections (Channel & Video Performance Metrics)
    match /analytics/{channelId}/{document=**} {
      allow read: if isAuthenticated() && (
        request.auth.uid == channelId ||
        (exists(/databases/$(database)/documents/channels/$(channelId)) &&
         get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow write: if false; // System / Cloud Functions only
    }

    match /video_analytics/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // System / Cloud Functions only
    }

    // Payment Orders, Receipts & Subscriptions Collections
    match /payment_orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /payment_receipts/{receiptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /payment_subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Advertiser Billing & Jobs
    match /billing_transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.advertiserId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /ad_resolution_jobs/{jobId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /verificationReports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Shorts Collection (Parity with Videos)
    match /shorts/{shortId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                       (!('uploaderId' in request.resource.data) || request.resource.data.uploaderId == request.auth.uid) &&
                       (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
                       (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
                       (request.resource.data.uploaderId == request.auth.uid ||
                        request.resource.data.userId == request.auth.uid ||
                        request.resource.data.ownerId == request.auth.uid ||
                        isAdmin()) &&
                       !('credibilityScore' in request.resource.data) &&
                       !('truthScore' in request.resource.data) &&
                       !('gatewayDecision' in request.resource.data) &&
                       (!('pipelineStatus' in request.resource.data) || request.resource.data.pipelineStatus == 'pending' || request.resource.data.pipelineStatus == 'uploading') &&
                       (!('credibilityVerified' in request.resource.data) || request.resource.data.credibilityVerified == false) &&
                       (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
                       (!('factCheck' in request.resource.data) || request.resource.data.factCheck == null) &&
                       (!('views' in request.resource.data) || request.resource.data.views == 0) &&
                       (!('viewCount' in request.resource.data) || request.resource.data.viewCount == 0) &&
                       (!('playCount' in request.resource.data) || request.resource.data.playCount == 0);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        ((isVideoOwner(shortId) || isVideoDataOwner(resource.data)) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'ownerId', 'userId', 'channelId', 'uploaderId',
           'credibilityScore', 'factCheck', 'truthScore', 'pipelineStatus', 'moderation', 'moderationReason', 'gatewayDecision',
           'views', 'viewCount', 'playCount', 'credibilityVerified', 'isVerified',
           'credibility', 'credibilityStatus', 'factCheckDispute', 'claimLedger', 'factCheckStats', 'uiReport', 'isFactChecked', 'scoringFactors'
         ])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likeCount', 'dislikeCount', 'likes', 'dislikes', 'views', 'viewCount', 'shareCount', 'playCount', 'engagement', 'languageRequestsCount', 'commentCount', 'commentsCount', 'totalWatchTimeSeconds', 'updatedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likeCount']) ||
         (!('likeCount' in resource.data) && (request.resource.data.likeCount == 0 || request.resource.data.likeCount == 1)) ||
         ('likeCount' in resource.data && (
           request.resource.data.likeCount == resource.data.likeCount + 1 ||
           request.resource.data.likeCount == resource.data.likeCount - 1 ||
           request.resource.data.likeCount == resource.data.likeCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dislikeCount']) ||
         (!('dislikeCount' in resource.data) && (request.resource.data.dislikeCount == 0 || request.resource.data.dislikeCount == 1)) ||
         ('dislikeCount' in resource.data && (
           request.resource.data.dislikeCount == resource.data.dislikeCount + 1 ||
           request.resource.data.dislikeCount == resource.data.dislikeCount - 1 ||
           request.resource.data.dislikeCount == resource.data.dislikeCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount']) ||
         (!('viewCount' in resource.data) && request.resource.data.viewCount == 1) ||
         ('viewCount' in resource.data && (
           request.resource.data.viewCount == resource.data.viewCount + 1 ||
           request.resource.data.viewCount == resource.data.viewCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['views']) ||
         (!('views' in resource.data) && request.resource.data.views == 1) ||
         ('views' in resource.data && (
           request.resource.data.views == resource.data.views + 1 ||
           request.resource.data.views == resource.data.views
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shareCount']) ||
         (!('shareCount' in resource.data) && (request.resource.data.shareCount == 0 || request.resource.data.shareCount == 1)) ||
         ('shareCount' in resource.data && (
           request.resource.data.shareCount == resource.data.shareCount + 1 ||
           request.resource.data.shareCount == resource.data.shareCount
         ))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['playCount']) ||
         (!('playCount' in resource.data) && (request.resource.data.playCount == 0 || request.resource.data.playCount == 1)) ||
         ('playCount' in resource.data && (
           request.resource.data.playCount == resource.data.playCount + 1 ||
           request.resource.data.playCount == resource.data.playCount
         ))))
      );
      allow delete: if isAuthenticated() && (isAdmin() || isVideoOwner(shortId) || isVideoDataOwner(resource.data));
    }

    // Admin Collections (Strictly protected, accessible only by authenticated administrators)
    match /admin_members/{doc=**} {
      allow read: if isAdmin();
      allow write: if false; // Only Admin SDK / Cloud Functions should write
    }
    match /content_appeals/{doc=**} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /flagged_images_review/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /rejected_images_log/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /admin_alerts/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /security_anomalies/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /account_clusters/{doc=**} {
      allow read, write: if isAdmin();
    }
    // Video Processing Pipeline Jobs Collection
    match /video_jobs/{jobId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        isVideoOwner(jobId) || 
        (resource.data.videoId != null && isVideoOwner(resource.data.videoId))
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.userId == request.auth.uid && 
         (isVideoOwner(jobId) || !exists(/databases/$(database)/documents/videos/$(jobId))))
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        ((resource.data.userId == request.auth.uid || isVideoOwner(jobId)) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']))
      );
      allow delete: if isAdmin();
    }
    match /pipeline_errors/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /userTrust/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    match /admin_actions_log/{doc=**} {
      allow read, write: if isAdmin();
    }

    // Broadcast Notifications Collection
    // Platform-wide push notification broadcast history.
    // - Read: Admins and Super Admins only (to inspect campaign history and delivery analytics)
    // - Write: Denied for all client SDKs; created exclusively by Cloud Functions via Firebase Admin SDK
    match /broadcast_notifications/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Search and Trending Collections
    match /trending_searches/{docId} {
      allow read: if true;
      allow write: if false; // System / Cloud Functions only
    }
    match /search_analytics/{docId} {
      allow read, write: if false; // Replaced by client-side Firebase Analytics SDK
    }
    // Financial & Economy Collections
    match /revenue_statements/{statementId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Cloud Functions only
    }

    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Cloud Functions only
    }

    match /payout_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount is number &&
                       request.resource.data.amount >= 100 &&
                       request.resource.data.status == 'pending' &&
                       (!('bypassScheduleCheck' in request.resource.data) || request.resource.data.bypassScheduleCheck == false) &&
                       request.resource.data.channelId is string &&
                       exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId)) &&
                       get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /channel_wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Immutable ledger authored exclusively by Cloud Functions
    }

    // Institutional Verification Requests
    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // User Feedback & Suggestions Collection (Requires Authentication)
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.feedbackText is string &&
        request.resource.data.feedbackText.size() >= 5 &&
        request.resource.data.feedbackText.size() <= 5000 &&
        (!('rating' in request.resource.data) || (request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5));
      allow update, delete: if isAdmin();
    }

    // Content Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legal DMCA & Rule 75 Copyright Complaints (Requires Authentication)
    match /copyright_complaints/{complaintId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (('userId' in resource.data && resource.data.userId == request.auth.uid) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Premium Subscription Plans & User Subscriptions
    match /premium_plans/{planId} {
      allow read: if true; // Public catalog of subscription plans
      allow write: if isAdmin();
    }
    match /premiumSubscriptions/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Premium Revenue Allocations — Transparent audit trail of subscription revenue sharing
    // Written by Cloud Functions (Admin SDK), readable by channel owners and admins
    match /premium_revenue_allocations/{allocId} {
      // Channel owners can read their own allocations
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.channelOwnerId == request.auth.uid)
      );
      // Only Cloud Functions (Admin SDK) write these — deny all client writes
      allow write: if false;
    }

    // Distribution Run Audit Records — Monthly job metadata and totals
    match /distribution_runs/{month} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Creator Community Fund — Unallocated creator pool reserve & accounting
    match /creator_community_fund/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // Ad Impression Events — Transparent per-impression revenue audit trail
    // Written exclusively by Cloud Functions (Admin SDK). Never client-writable.
    match /ad_impression_events/{impressionId} {
      // Channel owners can read impressions served on their channel
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.channelOwnerId == request.auth.uid) ||
        (resource.data.advertiserUserId == request.auth.uid)
      );
      allow write: if false; // Admin SDK only
    }

    // Ad Impression Rate Limits — Internal abuse prevention counters
    // Written and read only by Cloud Functions.
    match /ad_impression_ratelimits/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    // Fraud Review Queue — admin read/write only
    match /fraud_review_queue/{channelId} {
      allow read, write: if isAdmin();
    }

    // Revenue Hour Snapshots — internal fraud detection snapshots
    match /revenue_hour_snapshots/{snapshotId} {
      allow read, write: if false; // Admin SDK only
    }

    // Ad Impression IP Limits — internal rate limit counters
    match /ad_impression_ip_limits/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    // Ad Impression Subnet Counts — cluster detection counters
    match /ad_impression_subnet_counts/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    // Community Post Drafts
    match /communityDrafts/{draftId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Creator KYC Master Identity & Document Records
    match /creator_kyc/{channelId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.auth.uid == channelId || isAdmin());
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid &&
         (!('kycStatus' in request.resource.data) || request.resource.data.kycStatus == 'pending') &&
         (!('isNameMatched' in request.resource.data) || request.resource.data.isNameMatched == false)) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'kycStatus', 'isNameMatched', 'nameMatchScore', 'reviewedAt', 'reviewedBy', 'userId'
         ]))
      );
      allow delete: if isAdmin();
    }

    // Formal IFCN Fact-Check Appeals - Cryptographically audited via Cloud Functions
    match /claim_appeals/{appealId} {
      allow read: if isAuthenticated() && (resource.data.appellantId == request.auth.uid || isAdmin());
      allow write: if false; // Written and resolved exclusively via Cloud Functions
    }

    // Cryptographic SHA-256 Governance Audit Logs - Tamper-evident append-only ledger
    match /governance_audit_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.performerId == request.auth.uid || isAdmin());
      allow write: if false; // Written exclusively via Cloud Functions
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

