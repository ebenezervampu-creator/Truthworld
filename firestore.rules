rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'ebenezervampu4@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true))
      );
    }
    
    // Channel Drafts Collection
    match /channel_drafts/{draftId} {
      // Allow users to read their own drafts
      allow read: if isAuthenticated() && 
                     resource.data.ownerId == request.auth.uid;
      
      // Allow users to create their own drafts
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['ownerId', 'channelName', 'updatedAt']);
      
      // Allow users to update their own drafts
      allow update: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == request.auth.uid;
      
      // Allow users to delete their own drafts
      allow delete: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;
    }
    
    // Channels Collection
    match /channels/{channelId} {
      // Allow anyone to read channels (needed for discovery and collection listing)
      allow read: if true;
      
      // Allow authenticated users to create channels
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Allow owners or admins to update their channels, or any authenticated user to toggle subscription
      allow update: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid || 
                        isAdmin() ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount', 'lastActiveAt']) &&
                         (request.resource.data.subscriberCount == resource.data.subscriberCount + 1 ||
                          request.resource.data.subscriberCount == resource.data.subscriberCount - 1)));
      
      // Allow owners or admins to delete their channels
      allow delete: if isAuthenticated() && 
                       (resource.data.ownerId == request.auth.uid || isAdmin());

      // Subscribers subcollection
      match /subscribers/{subscriberId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == subscriberId;
      }

      // Stats subcollection (detailed analytics, watch time, views history)
      match /stats/{docId} {
        allow read: if isAuthenticated();
        allow write: if false; // System only
      }

      // Daily Stats subcollection (for analytics dashboards)
      match /daily_stats/{docId} {
        allow read: if isAuthenticated();
        allow write: if false; // System only
      }

      match /moderators/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && 
                         get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid;
      }

      // Blocked Users subcollection
      match /blocked_users/{userId} {
        allow read: if isAuthenticated() && 
                         (request.auth.uid == userId ||
                          get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid);
        allow write: if isAuthenticated() && 
                         get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid;
      }

      // Videos subcollection (alternate path)
      match /videos/{videoId} {
        allow read: if true;
        allow write: if isAuthenticated() && 
                         (resource.data.ownerId == request.auth.uid ||
                          request.resource.data.ownerId == request.auth.uid);
      }
    }
    
    // Image Status Collection (for moderation)
    match /image_status/{imageId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Image Verification Collection
    match /image_verification/{verificationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }
    
    // Videos Collection
    match /videos/{videoId} {
      // Allow anyone to read public videos
      allow read: if true;
      
      // Allow authenticated users to create videos (flexible field check)
      allow create: if isAuthenticated() && 
                       (request.resource.data.uploaderId == request.auth.uid ||
                        request.resource.data.userId == request.auth.uid ||
                        request.resource.data.ownerId == request.auth.uid);
      
      // Allow owners to update their videos (check multiple possible fields)
      allow update: if isAuthenticated() && 
                       (resource.data.uploaderId == request.auth.uid ||
                        resource.data.userId == request.auth.uid ||
                        resource.data.ownerId == request.auth.uid);
      
      // Allow owners to delete their videos
      allow delete: if isAuthenticated() && 
                       (resource.data.uploaderId == request.auth.uid ||
                        resource.data.userId == request.auth.uid ||
                        resource.data.ownerId == request.auth.uid);

      // Media subcollection (localization, credibility, streaming)
      match /media/{docId} {
        allow read: if true;
        allow write: if false; // System / Cloud Functions only
      }

      // View tracking subcollection (one doc per user per video)
      match /views/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Likes/Dislikes subcollections
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /dislikes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && 
                                 resource.data.userId == request.auth.uid;

        // Replies subcollection
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated();
          allow update, delete: if isAuthenticated() && 
                                   resource.data.userId == request.auth.uid;

          match /likes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }

          match /dislikes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }
        }

        match /likes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }
    
    // Topics Collection
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAuthenticated();

      // Likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Followers subcollection
      match /followers/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && 
                                 (resource.data.userId == request.auth.uid || 
                                  resource.data.channelId == request.auth.uid);

        // Replies subcollection
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated();
          allow update, delete: if isAuthenticated() && 
                                   (resource.data.userId == request.auth.uid || 
                                    resource.data.channelId == request.auth.uid);
        }
      }
    }

    // Legacy Topic Likes Collection
    match /topic_likes/{likeId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Legacy Topic Followers Collection
    match /topic_followers/{followId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Topic Reports Collection
    match /topic_reports/{reportId} {
      allow read: if false; // Admin only
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // Video Transcripts Subcollection (legacy — backend write only)
    match /videos/{videoId}/transcripts/{transcriptId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend service account can write
    }

    // Pipeline Errors Collection (backend monitoring)
    match /pipeline_errors/{errorId} {
      allow read: if false; // Admin console only
      allow write: if false; // Only backend can write
    }

    // Subscriptions Collection (Legacy/Frontend)
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;

      // Subcollection for user-specific subscription lists (/subscriptions/{userId}/list/{docId})
      match /list/{docId} {
        allow read, write: if isAuthenticated() && subscriptionId == request.auth.uid;
      }
    }

    // User Cache Collection
    match /userCache/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Channel Subscribers Collection (Cloud Functions / New Schema)
    match /channel_subscribers/{subId} {
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || 
                      resource.data.channelId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownedChannels);
      allow write: if false; // Only Cloud Functions should write here
    }
    
    // Users Collection
    match /users/{userId} {
      // Allow anyone to read public user profiles
      allow read: if true;
      
      // Allow users to create/update their own profile
      allow create, update: if isAuthenticated() && 
                               request.auth.uid == userId;
      
      // Prevent deletion
      allow delete: if false;

      // User Playlists subcollection
      match /playlists/{playlistId} {
        allow read: if resource.data.isPublic == true || 
                       (isAuthenticated() && request.auth.uid == userId);
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;

        match /items/{videoId} {
          allow read: if get(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId)).data.isPublic == true ||
                         (isAuthenticated() && request.auth.uid == userId);
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      // User Clips subcollection
      match /clips/{clipId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Videos subcollection
      match /likedVideos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Watch Later subcollection
      match /watch_later/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Feed Inbox subcollection (Materialized Fan-Out Feeds)
      match /feed_inbox/{videoId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Topics subcollection
      match /likedTopics/{topicId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Topics subcollection
      match /savedTopics/{topicId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Topic Comments subcollection
      match /liked_topic_comments/{commentId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Topic Replies subcollection
      match /liked_topic_replies/{replyId} {
        allow read, write: if isOwner(userId);
      }

      // User Video Comment Interactions subcollection
      match /comment_interactions/{commentId} {
        allow read, write: if isOwner(userId);
      }

      // User Video Reply Interactions subcollection
      match /reply_interactions/{replyId} {
        allow read, write: if isOwner(userId);
      }

      // User Liked Clips subcollection
      match /liked_clips/{clipId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Community Posts subcollection
      match /savedCommunityPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // User Saved Comments subcollection
      match /savedComments/{commentId} {
        allow read, write: if isOwner(userId);
      }

      // User Hidden Community Posts subcollection
      match /hiddenCommunityPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // User Muted Community Channels subcollection
      match /mutedCommunityChannels/{channelId} {
        allow read, write: if isOwner(userId);
      }

      // User Reported Community Posts subcollection
      match /reportedCommunityPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // User Subscriptions subcollection
      match /subscriptions/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // User Notifications Collection
    match /user_notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Feedback Collection
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // Comments Collection
    match /comments/{commentId} {
      // Allow anyone to read comments
      allow read: if true;
      
      // Allow authenticated users to create comments
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Allow comment owners to update/delete
      allow update, delete: if isAuthenticated() && 
                               resource.data.userId == request.auth.uid;
    }
    
    // Likes Collection
    match /likes/{likeId} {
      // Allow anyone to read likes
      allow read: if true;
      
      // Allow authenticated users to create/delete their own likes
      allow create, delete: if isAuthenticated() && 
                               request.resource.data.userId == request.auth.uid;
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      // Allow users to read their own notifications
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Allow system/backend to create notifications
      allow create: if isAuthenticated();
      
      // Allow users to update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Allow users to delete their own notifications
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Playlists Collection
    match /playlists/{playlistId} {
      // Allow anyone to read public playlists
      allow read: if resource.data.isPublic == true || 
                     resource.data.visibility in ['Public', 'public'] ||
                     (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      
      // Allow authenticated users to create playlists
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Allow owners to update/delete their playlists
      allow update, delete: if isAuthenticated() && 
                               resource.data.ownerId == request.auth.uid;
    }

    // Community Collection
    match /Community/{postId} {
      // Allow anyone to read community posts
      allow read: if true;
      
      // Allow authenticated users to create community posts
      allow create: if isAuthenticated() && 
                       request.resource.data.ownerId == request.auth.uid;
      
      // Allow owners to update/delete, or other users to update interaction fields
       allow update: if isAuthenticated() && (
                        resource.data.ownerId == request.auth.uid ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'likes', 'likedBy', 'dislikes', 'dislikedBy'
                        ]) &&
                        (request.resource.data.likes == resource.data.likes + 1 ||
                         request.resource.data.likes == resource.data.likes - 1 ||
                         request.resource.data.likes == resource.data.likes) &&
                        (request.resource.data.dislikes == resource.data.dislikes + 1 ||
                         request.resource.data.dislikes == resource.data.dislikes - 1 ||
                         request.resource.data.dislikes == resource.data.dislikes))
                     );
                    
      allow delete: if isAuthenticated() && 
                       resource.data.ownerId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && 
                                 (resource.data.userId == request.auth.uid || 
                                  resource.data.channelId == request.auth.uid ||
                                  resource.data.ownerId == request.auth.uid);

        // Replies subcollection
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated();
          allow update, delete: if isAuthenticated() && 
                                   (resource.data.userId == request.auth.uid || 
                                    resource.data.channelId == request.auth.uid ||
                                    resource.data.ownerId == request.auth.uid);

          match /likes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }

          match /dislikes/{userId} {
            allow read: if true;
            allow write: if isAuthenticated() && request.auth.uid == userId;
          }
        }

        match /likes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }

        match /dislikes/{userId} {
          allow read: if true;
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    // Public Playlists Collection (alternate root)
    match /public_playlists/{playlistId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
                               resource.data.ownerId == request.auth.uid;

      match /items/{videoId} {
        allow read: if true;
        allow write: if isAuthenticated() && 
                         (get(/databases/$(database)/documents/public_playlists/$(playlistId)).data.ownerId == request.auth.uid ||
                          request.resource.data.ownerId == request.auth.uid);
      }
    }
    
    // Channel Slugs (for availability check)
    match /channel_slugs/{slug} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false; // Slugs are managed by backend/system
    }

    // Analytics and Stats
    match /video_stats/{videoId} {
      allow read: if true;
      allow write: if false; // System only
    }

    match /video_state_stats/{videoId} {
      allow read: if true;
      allow write: if false; // System only

      match /states/{stateId} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    // Watch History — per user per video (merge upsert)
    match /users/{userId}/watch_history/{videoId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Watch History Collection (legacy)
    match /watch_history/{historyId} {
      // Allow users to read their own watch history
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Allow users to create their own watch history
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Allow users to delete their own watch history
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Feeds Collection (for aggregated data like 'home')
    match /feeds/{feedId} {
      allow read: if true;
      allow write: if false; // Only backend or admin should write
    }

    // ================================================================
    // ANALYTICS COLLECTIONS (server-written, client-read)
    // ================================================================

    // Raw watch events (written by Cloud Function, read by aggregator)
    match /watch_events_raw/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Pre-aggregated daily video stats
    match /video_stats_daily/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Pre-aggregated daily channel stats
    match /channel_stats_daily/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Resolution jobs (transcoding status)
    match /resolution_jobs/{jobId} {
      allow read: if true;
      allow write: if false; // Backend only
    }

    // Live viewing sessions (written by Cloud Function)
    match /live_sessions/{videoId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only

      match /viewers/{viewerId} {
        allow read: if isAuthenticated();
        allow write: if false; // Cloud Function only
      }
    }

    // Pre-aggregated hourly video stats (real-time recent trends)
    match /video_stats_hourly/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function only
    }

    // Server-side view dedup: 1 qualified view per user per video per day
    // Document ID: `{videoId}_{userId}_{YYYY_MM_DD}`
    match /qualified_views/{dedupId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Function creates via transaction
    }

    // Fraud flags — server-evaluated behavioral anomalies
    match /fraud_flags/{flagId} {
      allow read: if false; // Admin console only
      allow write: if false; // Cloud Function only
    }

    // Impression events — thumbnail visibility tracking for true CTR
    match /impressions_raw/{impressionId} {
      allow read: if false; // Aggregator only
      allow create: if isAuthenticated(); // Client batches impressions
      allow update, delete: if false;
    }

    // Idempotency keys — prevents duplicate Cloud Function event writes
    match /idempotency_keys/{keyId} {
      allow read: if false; // Cloud Function internal
      allow write: if false; // Cloud Function only
    }

    // Copyright Assets Collection
    match /copyright_assets/{assetId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Copyright Chunks Collection
    match /copyright_chunks/{chunkId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Copyright Matches Collection
    match /copyright_matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Copyright Claims Collection
    match /copyright_claims/{claimId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Copyright Appeals Collection
    match /copyright_appeals/{appealId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // Content Verifications Collection
    match /content_verifications/{verificationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    // AI Health state (Circuit Breaker)
    match /_ai_health/{document=**} {
      allow read, write: if false; // Only Cloud Functions service accounts can access
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read, update, delete: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.reportedBy == request.auth.uid ||
        request.resource.data.userEmail == request.auth.token.email
      );
    }

    // Admin Collections
    match /flagged_images_review/{docId} {
      allow read, write: if isAdmin();
    }
    match /rejected_images_log/{docId} {
      allow read: if isAdmin();
      allow write: if false; // System only
    }
    match /video_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false; // System only
    }
    match /pipeline_errors/{errorId} {
      allow read: if isAdmin();
      allow write: if false; // System only
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

