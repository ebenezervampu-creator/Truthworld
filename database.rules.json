{
  "rules": {
    "activeViewers": {
      "$videoId": {
        ".read": true,
        "$sessionId": {
          ".read": true,
          ".write": "auth != null && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid', 'watchedSeconds', 'position', 'updatedAt'])"
        }
      }
    },
    "liveStats": {
      ".read": true,
      ".write": false,
      "$videoId": {
        ".read": true,
        "concurrentCount": {
          ".read": true
        }
      },
      "global": {
        ".read": true,
        "concurrentCount": {
          ".read": true
        }
      }
    },
    "videoCache": {
      ".read": true,
      "$videoId": {
        ".read": true,
        ".write": "auth != null && (newData.child('ownerId').val() === auth.uid || !data.exists())"
      }
    },
    "userCache": {
      ".read": true,
      "$userId": {
        ".read": true,
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "videoList": {
      ".read": true,
      "$channelId": {
        ".read": true,
        ".write": false
      }
    },
    "commentCounts": {
      ".read": true,
      "$videoId": {
        ".read": true,
        ".write": false
      }
    }
  }
}
