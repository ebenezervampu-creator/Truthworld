{
  "name": "functions",
  "scripts": {
    "build": "tsc && node generate-manifest.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/api tests/auth tests/callable tests/database tests/payment --runInBand",
    "test:api": "jest tests/api --runInBand",
    "test:callable": "jest tests/callable --runInBand",
    "test:auth": "jest tests/auth --runInBand",
    "test:db": "jest tests/database --runInBand",
    "test:security": "jest tests/security --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "test:smoke": "jest tests/smoke --runInBand",
    "test:load": "node tests/load/runner.js",
    "test:legacy": "ts-node src/resolution/__tests__/resolution_audio_quality.test.ts && ts-node src/resolution/__tests__/resolution_60fps.test.ts && ts-node src/notifications/__tests__/notifications_features.test.ts && ts-node src/pipeline/__tests__/ai_features_backend.test.ts && ts-node src/pipeline/__tests__/claim_scaling.test.ts && ts-node src/economy/__tests__/premiumRevenueDistribution.test.ts && ts-node src/search/__tests__/searchBackend.test.ts && ts-node src/services/__tests__/cashfreeService.test.ts",
    "test:resolution": "ts-node src/resolution/__tests__/resolution_audio_quality.test.ts && ts-node src/resolution/__tests__/resolution_60fps.test.ts && ts-node src/resolution/__tests__/resolution_reconcile.test.ts",
    "test:ai": "ts-node src/pipeline/__tests__/ai_features_backend.test.ts",
    "test:p95-p99": "npx ts-node src/benchmark/percentile_latency.test.ts",
    "test:verification": "npx ts-node src/benchmark/video_upload_verification.test.ts",
    "test:scalability": "npx ts-node src/benchmark/backend_scalability.test.ts",
    "test:k6": "node ../tests/k6/runner.js",
    "test:contracts": "jest tests/contracts --runInBand",
    "test:all": "npm run test && npm run test:legacy && npm run test:scalability && npm run test:p95-p99 && npm run test:load",
    "benchmark": "npx ts-node src/benchmark/index.ts",
    "benchmark:scalability": "npx ts-node src/benchmark/backend_scalability.test.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/pubsub": "^3.7.5",
    "@google-cloud/text-to-speech": "^7.2.0",
    "@google-cloud/translate": "^8.1.0",
    "@google-cloud/vertexai": "^1.3.0",
    "@google-cloud/vision": "^4.1.0",
    "axios": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5",
    "fluent-ffmpeg": "^2.1.3",
    "nodemailer": "^10.0.16",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "dotenv": "^18.0.5",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "private": true
}
