{
  "name": "functions",
  "scripts": {
    "build": "tsc && node generate-manifest.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "ts-node src/notifications/__tests__/notifications_features.test.ts",
    "test:ai": "ts-node src/pipeline/__tests__/ai_features_backend.test.ts",
    "benchmark": "npx ts-node src/benchmark/index.ts",
    "benchmark:scalability": "npx ts-node src/benchmark/backend_scalability.test.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/pubsub": "^3.7.5",
    "@google-cloud/translate": "^8.1.0",
    "@google-cloud/vertexai": "^1.3.0",
    "@google-cloud/vision": "^4.1.0",
    "axios": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "private": true
}
